\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{src/profiles/undf-artigo}[2026/10/14 TCC em formato de artigo]

\makeatletter

% Faixa orientadora do modelo, inspirada na NBR 6028 para artigos de periódicos.
\renewcommand{\undf@abstractminwords}{100}
\renewcommand{\undf@abstractmaxwords}{250}
\renewcommand{\undf@abstractwordsguidance}{o modelo de artigo recomenda de}

% Seções contínuas, independentes do contador de capítulos da classe report.
\counterwithout{section}{chapter}
\counterwithout{figure}{chapter}
\counterwithout{table}{chapter}
\counterwithout{equation}{chapter}
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{3}
\renewcommand\section{%
  \@startsection{section}{1}{\z@}{\baselineskip}{.5\baselineskip}{\normalfont\bfseries}%
}
\renewcommand\subsection{%
  \@startsection{subsection}{2}{\z@}{\baselineskip}{.5\baselineskip}{\normalfont\bfseries}%
}
\renewcommand\subsubsection{%
  \@startsection{subsubsection}{3}{\z@}{\baselineskip}{.5\baselineskip}{\normalfont\bfseries\itshape}%
}
\renewcommand\chapter{%
  \ClassError{undftex}{O perfil artigo usa \string\section, nao \string\chapter}%
    {Use \string\section\space e \string\input\space no miolo do artigo.}%
}

% O sumário do volume acompanha a hierarquia real do miolo.
\titlecontents{section}[0em]{\bfseries}{\contentslabel{2.3em}}{}{\hfill\contentspage}
\titlecontents{subsection}[2.3em]{\normalfont}{\contentslabel{2.8em}}{}{\hfill\contentspage}
\titlecontents{subsubsection}[5.1em]{\itshape}{\contentslabel{3.3em}}{}{\hfill\contentspage}

% Referências pertencem ao artigo e seguem o texto sem quebra obrigatória.
\defbibheading{undfreferences}[REFERÊNCIAS]{%
  \section*{#1}%
  \phantomsection
  \addcontentsline{toc}{section}{#1}%
}

\def\undf@artigotituloestrangeiro{}
\newcommand{\tituloartigoestrangeiro}[1]{\gdef\undf@artigotituloestrangeiro{#1}}
\def\undf@artigoidentificacao{}
\def\undf@artigovinculo{\undf@instituicao}
\def\undf@artigoemail{}
\newcommand{\identificacaoautor}[1]{\gdef\undf@artigoidentificacao{#1}}
\newcommand{\vinculoautor}[1]{\gdef\undf@artigovinculo{#1}}
\newcommand{\emailautor}[1]{\gdef\undf@artigoemail{#1}}

\newcommand{\undf@resumoartigo}[4]{%
  \undfifcontent{#1}{%
    \begingroup
      \undfwarnabstractwords{#1}{#3 do artigo}%
      \par\addvspace{\baselineskip}%
      \noindent\textbf{#3}\par\nobreak
      \noindent
      \ifstrequal{#1}{abstract}
        {\foreignlanguage{english}{\undfusecontent{#1}\par}}
        {\undfusecontent{#1}\par}%
      \undfifcontent{#2}{#4{\undfusecontent{#2}}}{}%
    \endgroup
  }{}%
}

% A nota de autoria usa símbolo próprio sem consumir a numeração das notas do texto.
\newcommand{\undf@artigonotaautor}{%
  \begingroup
    \renewcommand{\thefootnote}{\fnsymbol{footnote}}%
    \footnote[1]{%
      \ifdefempty{\undf@artigoidentificacao}{}{\undf@artigoidentificacao\space}%
      \undf@artigovinculo
      \ifdefempty{\undf@artigoemail}{}{%
        \par\noindent Contato: \href{mailto:\undf@artigoemail}{\expandafter\nolinkurl\expandafter{\undf@artigoemail}}.%
      }%
    }%
  \endgroup
}

% Inicia na página 1 quando autônomo; preserva a contagem se houver apresentação institucional.
\newcommand{\undfinicioartigo}{%
  \ifdefempty{\undf@titulo}{\PackageWarningNoLine{undf-artigo}{Preencha o titulo do artigo}}{}%
  \ifdefempty{\undf@autor}{\PackageWarningNoLine{undf-artigo}{Preencha a autoria do artigo}}{}%
  \undfwarnifempty{resumo}{Preencha o resumo do artigo}%
  \undfwarnifempty{palavraschave}{Preencha as palavras-chave do artigo}%
  \undfifcontent{abstract}
    {\undfwarnifempty{keywords}{Preencha as keywords do abstract}}%
    {\undfifcontent{keywords}{\PackageWarningNoLine{undf-artigo}{Keywords sem abstract; preencha o abstract ou remova as keywords}}{}}%
  \textual
  \singlespacing
  \begin{center}
    {\large\bfseries\undf@titlefull\par}%
    \ifdefempty{\undf@artigotituloestrangeiro}{}{\medskip\undf@artigotituloestrangeiro\par}%
    \medskip
    \undf@autor\undf@artigonotaautor\par
    \ifdefempty{\undf@orientador}{}{\medskip{\small Orientação: \undf@orientador\par}}%
    \ifdefempty{\undf@coorientador}{}{{\small Coorientação: \undf@coorientador\par}}%
  \end{center}
  \undf@resumoartigo{resumo}{palavraschave}{Resumo}{\palavraschave}%
  \undf@resumoartigo{abstract}{keywords}{Abstract}{\keywords}%
}

% Complementos do artigo seguem o fluxo textual e usam o mesmo nível no sumário.
\newcommand{\undf@complementoartigo}[1]{%
  \section*{#1}%
  \phantomsection
  \addcontentsline{toc}{section}{#1}%
}
\renewenvironment{undfglossario}
  {\undf@complementoartigo{GLOSSÁRIO}\begingroup\setlength{\parindent}{0pt}}
  {\par\endgroup}
\renewcommand{\apendice}[1]{%
  \undf@begincomplement{undfapendice}%
  \undf@complementoartigo{APÊNDICE \Alph{undfapendice} --- \MakeTextUppercase{#1}}%
  \protected@edef\@currentlabelname{APÊNDICE \undf@complementprefix\space --- \unexpanded{#1}}%
}
\renewcommand{\anexo}[1]{%
  \undf@begincomplement{undfanexo}%
  \undf@complementoartigo{ANEXO \Alph{undfanexo} --- \MakeTextUppercase{#1}}%
  \protected@edef\@currentlabelname{ANEXO \undf@complementprefix\space --- \unexpanded{#1}}%
}
\renewenvironment{agradecimentos}
  {\undf@complementoartigo{AGRADECIMENTOS}}
  {\par}

\makeatother

% ----------------------------------------------------
% Glossário
% ----------------------------------------------------
% Interface oficial:
% \begin{undfglossario} ... \end{undfglossario}
% \undfglossitem{termo}{definição}
%
% Os nomes antigos glossario/\glossariotermo são mantidos
% como sinônimos de compatibilidade da mesma implementação.
% ----------------------------------------------------
\newenvironment{undfglossario}
  {%
    \posttextual
    \phantomsection
    \addcontentsline{toc}{chapter}{GLOSSÁRIO}%
    \thispagestyle{plain}%
    \begingroup
      \begin{center}
        \normalsize\bfseries\MakeUppercase{GLOSSÁRIO}\par
      \end{center}
      \vspace{\baselineskip}%
      \setlength{\parindent}{0pt}%
      \setlength{\parskip}{0.6\baselineskip}%
  }
  {%
    \endgroup
    \clearpage
  }

\newcommand{\undfglossitem}[2]{%
  \par\noindent\textbf{#1:} #2\par
}

\newenvironment{glossario}
  {\begin{undfglossario}}
  {\end{undfglossario}}

\newcommand{\glossariotermo}[2]{\undfglossitem{#1}{#2}}


\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{src/core/undf-structure}[2026/01/01 UnDF-TeX structure]

\makeatletter

% ----------------------------------------------------
% Estado estrutural do documento
% ----------------------------------------------------
\newif\ifundf@pretextual
\undf@pretextualfalse

% ----------------------------------------------------
% Transições estruturais do documento
% ----------------------------------------------------
% Pré-textual:
% - páginas contadas;
% - numeração não visível.
%
% Textual:
% - numeração visível em arábico;
% - página 1 reiniciada.
% ----------------------------------------------------

\newcommand{\undf@beginpretextual}{%
  \cleardoublepage
  \undf@pretextualtrue
  \pagenumbering{roman}%
  \setcounter{page}{1}%
  \pagestyle{empty}%
}

\newcommand{\undf@begintextual}{%
  \cleardoublepage
  \undf@pretextualfalse
  \pagenumbering{arabic}%
  \setcounter{page}{1}%
  \pagestyle{undftextual}%
}

\newcommand{\undf@beginposttextual}{%
  \cleardoublepage
  \undf@pretextualfalse
  \pagestyle{undftextual}%
}

\makeatother

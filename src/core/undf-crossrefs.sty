\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{src/core/undf-crossrefs}[2026/04/12 UnDF-TeX cross references]

\RequirePackage{amsmath}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{xparse}
\RequirePackage{listings}
\RequirePackage{needspace}

% ----------------------------------------------------
% Validacao de imagens oficiais do modelo
% ----------------------------------------------------
\newif\ifundf@avisosimagem
\undf@avisosimagemtrue

\newcommand{\undfdesabilitaravisosimagem}{\undf@avisosimagemfalse}
\newcommand{\undfhabilitaravisosimagem}{\undf@avisosimagemtrue}

\newcommand{\undf@validarimagem}[1]{%
  \ifundf@avisosimagem
    \directlua{
      undf_image_warnings_seen = undf_image_warnings_seen or {}
      local raw = "\luaescapestring{#1}"
      local path = kpse.find_file(raw) or raw
      local file = io.open(path, "rb")
      if file then
        local size = file:seek("end")
        file:close()
        if size then
          local mb = size / 1048576
          if mb > 5 and not undf_image_warnings_seen[path] then
            undf_image_warnings_seen[path] = true
            local rounded = math.floor(mb * 10 + 0.5) / 10
            local level = "imagem pesada"
            local advice = "recomenda-se otimizar para um tamanho abaixo de 5 MB antes da entrega final"
            if mb > 10 then
              level = "imagem muito pesada"
              advice = "recomenda-se fortemente otimizar para um tamanho abaixo de 5 MB antes da entrega final"
            end
            texio.write_nl("term and log", "")
            texio.write_nl("term and log", "Package undftex Warning: " .. level .. ": " .. raw .. " (" .. tostring(rounded) .. " MB); " .. advice .. ".")
            texio.write_nl("term and log", "")
          end
        end
      end
    }%
  \fi
}

% ----------------------------------------------------
% Referências cruzadas amigáveis
% ----------------------------------------------------
\newcommand{\figuraref}[1]{Figura~\ref{fig:#1}}
\newcommand{\tabelaref}[1]{Tabela~\ref{tab:#1}}
\newcommand{\equacaoref}[1]{Equação~\eqref{eq:#1}}
\newcommand{\secaoref}[1]{Seção~\ref{sec:#1}}
\newcommand{\apendiceref}[1]{Apêndice~\ref{ap:#1}}
\newcommand{\anexoref}[1]{Anexo~\ref{an:#1}}
\newcommand{\algoritmoref}[1]{Pseudocódigo~\ref{alg:#1}}
\newcommand{\pseudocodigoref}[1]{Pseudocódigo~\ref{alg:#1}}
\newcommand{\fluxogramaref}[1]{%
  \ifnum\undf@fluxogramatotal>3
    Fluxograma~\ref{flux:#1}%
  \else
    Figura~\ref{fig:#1}%
  \fi
}

% ----------------------------------------------------
% Seções amigáveis
% ----------------------------------------------------
\newcommand{\undfsecao}[2]{%
  \section{#1}%
  \label{sec:#2}%
}

\newcommand{\undfsubsecao}[2]{%
  \subsection{#1}%
  \label{sec:#2}%
}

\newcommand{\undfsubsubsecao}[2]{%
  \subsubsection{#1}%
  \label{sec:#2}%
}

% ----------------------------------------------------
% Equações amigáveis
% ----------------------------------------------------
\NewDocumentCommand{\equacao}{o m}{%
  \begin{equation}
    \IfValueT{#1}{\label{eq:#1}}%
    #2
  \end{equation}
}

\NewDocumentCommand{\equacaosemnumero}{m}{%
  \[
    #1
  \]
}

% ----------------------------------------------------
% Figuras amigáveis
% Uso:
% \undffigura{arquivo}{legenda}{rotulo}
% \undffigura[0.7\textwidth]{arquivo}{legenda}{rotulo}
% \undffigura[0.7\textwidth]{arquivo}{legenda}{rotulo}[IBGE, 2024]
% ----------------------------------------------------
\NewDocumentCommand{\undffigura}{O{0.8\textwidth} m m m O{\undf@fontedefault}}{%
  \begin{figure}[H]
    \centering
    \caption{#3}
    \label{fig:#4}
    \undf@validarimagem{#2}
    \includegraphics[width=#1,keepaspectratio]{#2}
    \undffonte{#5}
  \end{figure}
}

% ----------------------------------------------------
% Figuras lado a lado para comparação visual
% ----------------------------------------------------
\NewDocumentCommand{\undffigurasladoalado}{O{0.47\textwidth} m m m O{\undf@fontedefault} m m m O{\undf@fontedefault}}{%
  \begin{figure}[H]
    \centering
    \begin{minipage}[t]{#1}
      \centering
      \caption{#3}
      \label{fig:#4}
      \undf@validarimagem{#2}
      \includegraphics[width=\linewidth,keepaspectratio]{#2}
      \undffonte{#5}
    \end{minipage}\hfill
    \begin{minipage}[t]{#1}
      \centering
      \caption{#7}
      \label{fig:#8}
      \undf@validarimagem{#6}
      \includegraphics[width=\linewidth,keepaspectratio]{#6}
      \undffonte{#9}
    \end{minipage}
  \end{figure}
}

% ----------------------------------------------------
% Fluxogramas
% ----------------------------------------------------
% A decisao entre Figura e Fluxograma usa a contagem registrada no .aux.
% Compile novamente quando a quantidade de fluxogramas mudar.
\newcounter{undf@fluxogramacount}
\newcounter{undffluxograma}
\providecommand{\undf@fluxogramatotal}{0}

\AtEndDocument{%
  \ifnum\value{undf@fluxogramacount}=\undf@fluxogramatotal\relax
  \else
    \PackageWarning{undftex}{A quantidade de fluxogramas mudou. Recompile para estabilizar listas e rotulos}%
  \fi
  \if@filesw
    \immediate\write\@auxout{\string\gdef\string\undf@fluxogramatotal{\arabic{undf@fluxogramacount}}}%
  \fi
}

\NewDocumentEnvironment{undffluxograma}{O{H} m m O{\undf@fontedefault} +b}
  {%
    \stepcounter{undf@fluxogramacount}%
    \begin{figure}[#1]
      \centering
      \ifnum\undf@fluxogramatotal>3
        \refstepcounter{undffluxograma}%
        \caption*{Fluxograma~\theundffluxograma{} --- #2}%
        \addcontentsline{lofl}{fluxograma}{Fluxograma~\theundffluxograma{} --- #2}%
        \label{flux:#3}%
      \else
        \caption{#2}%
        \label{fig:#3}%
      \fi
      #5
      \undffonte{#4}
    \end{figure}%
  }
  {}
% ----------------------------------------------------
% Pseudocódigo
% ----------------------------------------------------
\newcounter{undfalgoritmo}

\newcommand{\undf@needpseudocodespace}{%
  \Needspace{5\baselineskip}%
}

\lstdefinestyle{undf-pseudocode}{
  basicstyle=\small\ttfamily,
  keywordstyle=\bfseries,
  commentstyle=\itshape,
  columns=fullflexible,
  keepspaces=true,
  showstringspaces=false,
  numbers=left,
  numberstyle=\scriptsize,
  numbersep=0.8em,
  frame=single,
  framerule=0.4pt,
  xleftmargin=1.5em,
  framexleftmargin=1.2em,
  framextopmargin=1.8em,
  belowcaptionskip=-1.55em,
  breaklines=true,
  tabsize=2,
  captionpos=t,
  alsoletter={-},
  morekeywords={Algoritmo,Entrada,Saida,Saída,Inicio,Início,Fim,Se,Entao,Então,Senao,Senão,Enquanto,Para,Faca,Faça,Retorne,Fim-se,Fim-para,Fim-enquanto,Fim-funcao,Fim-função}
}

% A assinatura fica dentro do quadro, alinhada a esquerda, ex.: MEDIA(V).
\newcommand{\undf@pseudocodetitle}[1]{\textsc{#1}\hfill\mbox{}}

\lstnewenvironment{undfpseudocodigo}[4][\undf@fontedefault]{%
  \undf@needpseudocodespace%
  \refstepcounter{undfalgoritmo}%
  \label{alg:#3}%
  \noindent\parbox{\linewidth}{\centering Pseudocódigo~\theundfalgoritmo{} --- #4}\endgraf\nobreak%
  \lstset{style=undf-pseudocode,title={\undf@pseudocodetitle{#2}}}%
}{%
  \undffonte{#1}%
}

\lstnewenvironment{undfpseudocodigolongo}[4][\undf@fontedefault]{%
  \refstepcounter{undfalgoritmo}%
  \label{alg:#3}%
  \noindent\parbox{\linewidth}{\centering Pseudocódigo~\theundfalgoritmo{} --- #4}\endgraf\nobreak%
  \lstset{style=undf-pseudocode,title={\undf@pseudocodetitle{#2}}}%
}{%
  \undffonte{#1}%
}

% ----------------------------------------------------
% Tabela avançada
% Uso:
% \begin{undftabela}{Legenda}{rotulo}
% ...
% \end{undftabela}
%
% \begin{undftabela}{Legenda}{rotulo}[IBGE, 1993]
% ...
% \end{undftabela}
% ----------------------------------------------------
\NewDocumentEnvironment{undftabela}{O{htb} m m O{\undf@fontedefault} +b}
  {%
    \begin{table}[#1]
      \centering
      \caption{#2}
      \label{tab:#3}
      #5
      \undffonte{#4}
    \end{table}
  }
  {}

% ----------------------------------------------------
% Apêndice e anexo amigáveis
% ----------------------------------------------------
\makeatletter

\newcommand{\undfapendice}[2]{%
  \apendice{#1}%
  \protected@edef\@currentlabel{\Alph{undfapendice}}%
  \label{ap:#2}%
}

\newcommand{\undfanexo}[2]{%
  \anexo{#1}%
  \protected@edef\@currentlabel{\Alph{undfanexo}}%
  \label{an:#2}%
}

% ----------------------------------------------------
% Fonte de ilustrações e tabelas
% ----------------------------------------------------
\newcommand{\undf@fontedefault}{elaboração própria}

\newcommand{\undffonte}[1]{%
  \par
  \begingroup
    \footnotesize
    Fonte: #1.\par
  \endgroup
}

\makeatother

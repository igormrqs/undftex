\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{src/core/undf-headings}[2026/01/01 UnDF-TeX special headings]

\makeatletter

% ----------------------------------------------------
% Títulos sem indicativo numérico
% ----------------------------------------------------
% Infraestrutura central para elementos como:
% resumo, sumário, referências, glossário, apêndices,
% anexos, listas e índice.
% ----------------------------------------------------

\newcommand{\undf@specialheading}[1]{%
  \cleardoublepage
  \ifundf@pretextual
    \thispagestyle{empty}%
  \else
    \thispagestyle{plain}%
  \fi
  {\centering
    \undf@sectioningfont
    \undf@sectioningtitle{#1}\par
  }%
  \vspace{\undf@sectioningafterskip}%
  \@afterheading
}

\newcommand{\undf@specialheadingwithtoc}[2]{%
  \undf@specialheading{#2}%
  \addcontentsline{toc}{#1}{#2}%
}

\makeatother

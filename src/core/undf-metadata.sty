% ----------------------------------------------------
% Macros auxiliares internas
% ----------------------------------------------------
\newcommand*{\undf@titlefull}{%
  \undf@titulo%
  \ifdefempty{\undf@subtitulo}
    {}
    {: \undf@subtitulo}%
}

% Compatibilidade com arquivos antigos do projeto
\newcommand*{\undf@fulltitle}{\undf@titlefull}

\newcommand*{\undf@defaultobjetivo}{%
  \undf@tipotrabalho%
  \ifdefempty{\undf@curso}
    {}
    { apresentado ao curso de \undf@curso,}%
  da \undf@instituicao,\space%
  como requisito parcial para obtenção do título de \undf@graupretendido.%
}

\newcommand*{\undf@naturezatexto}{%
  \ifdefempty{\undf@objetivo}
    {\undf@defaultobjetivo}
    {\undf@objetivo}%
  \ifdefempty{\undf@areaconcentracao}
    {}
    {\\Área de concentração: \undf@areaconcentracao.}%
}


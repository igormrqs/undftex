% ----------------------------------------------------
% Comandos públicos de metadados
% ----------------------------------------------------
% Autoria
\newcommand{\autor}[1]{%
  \gdef\undf@autor{#1}%
  \gdef\undf@autoresraw{#1}%
}

\newcommand{\autores}[1]{%
  \StrSubstitute{#1}{//}{, }[\undf@tmpautorlinha]%
  \xdef\undf@autor{\undf@tmpautorlinha}%
  \gdef\undf@autoresraw{#1}%
}

\newcommand{\undfprintautores}{%
  \begingroup
  \StrSubstitute{\undf@autoresraw}{//}{\\}[\undf@tmpautoresprint]%
  \MakeTextUppercase{\undf@tmpautoresprint}%
  \endgroup
}
\newcommand{\titulo}[1]{\gdef\undf@titulo{#1}}
\newcommand{\subtitulo}[1]{\gdef\undf@subtitulo{#1}}
\newcommand{\curso}[1]{\gdef\undf@curso{#1}}
\newcommand{\local}[1]{\gdef\undf@local{#1}}
\newcommand{\ano}[1]{\gdef\undf@ano{#1}}
\newcommand{\volume}[1]{\gdef\undf@volumenumero{#1}}

\newcommand{\tipotrabalho}[1]{\gdef\undf@tipotrabalho{#1}}
\newcommand{\graupretendido}[1]{\gdef\undf@graupretendido{#1}}
\newcommand{\objetivo}[1]{\gdef\undf@objetivo{#1}}
\newcommand{\areadeconcentracao}[1]{\gdef\undf@areaconcentracao{#1}}

\newcommand{\orientador}[1]{\gdef\undf@orientador{#1}}
\newcommand{\coorientador}[1]{\gdef\undf@coorientador{#1}}
\newcommand{\dataaprovacao}[1]{\gdef\undf@dataaprovacao{#1}}

% ----------------------------------------------------
% Normalizacao de nomes de orientadores e banca
% ----------------------------------------------------
\ExplSyntaxOn
\cs_new_protected:Npn \undf_print_person_name:n #1
  {
    \tl_set:Nx \l_tmpa_tl {#1}
    \regex_replace_once:nnN {\A\s*Professora\s*} {} \l_tmpa_tl
    \regex_replace_once:nnN {\A\s*Professor\s*} {} \l_tmpa_tl
    \regex_replace_once:nnN {\A\s*Profa\.?\s*} {} \l_tmpa_tl
    \regex_replace_once:nnN {\A\s*Prof\.?\s*} {} \l_tmpa_tl
    \regex_replace_once:nnN {\A\s*Doutora\s*} {} \l_tmpa_tl
    \regex_replace_once:nnN {\A\s*Doutor\s*} {} \l_tmpa_tl
    \regex_replace_once:nnN {\A\s*Dra\.?\s*} {} \l_tmpa_tl
    \regex_replace_once:nnN {\A\s*Dr\.?\s*} {} \l_tmpa_tl
    \regex_replace_once:nnN {\A\s*Mestra\s*} {} \l_tmpa_tl
    \regex_replace_once:nnN {\A\s*Mestre\s*} {} \l_tmpa_tl
    \regex_replace_once:nnN {\A\s*Ma\.?\s*} {} \l_tmpa_tl
    \regex_replace_once:nnN {\A\s*Me\.?\s*} {} \l_tmpa_tl
    \regex_replace_once:nnN {\A\s*M\.?Sc\.?\s*} {} \l_tmpa_tl
    \regex_replace_once:nnN {\A\s*Ms\.?\s*} {} \l_tmpa_tl
    \regex_replace_once:nnN {\A\s*Especialista\s*} {} \l_tmpa_tl
    \regex_replace_once:nnN {\A\s*Esp\.?\s*} {} \l_tmpa_tl
    \tl_trim_spaces:N \l_tmpa_tl
    \tl_use:N \l_tmpa_tl
  }
\cs_new_eq:NN \undfprintpersonname \undf_print_person_name:n
\ExplSyntaxOff


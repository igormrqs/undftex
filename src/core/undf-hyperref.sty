\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{src/core/undf-hyperref}[2026/04/14 UnDF-TeX hyperlinks]

\RequirePackage[
  unicode=true,
  psdextra,
  hidelinks,
  linktoc=all,
  bookmarksopen=true,
  bookmarksopenlevel=1,
  bookmarksnumbered=true
]{hyperref}

\RequirePackage{bookmark}

\makeatletter

% Evita problemas em bookmarks/PDF strings
\pdfstringdefDisableCommands{%
  \def\MakeTextUppercase#1{#1}%
  \def\MakeUppercase#1{#1}%
  \def\\{ - }%
}

% Metadados básicos do PDF
\AtBeginDocument{%
  \hypersetup{%
    pdftitle={\undf@fulltitle},
    pdfauthor={\undf@autor},
    pdfsubject={\undf@tipotrabalho},
    pdfcreator={UnDF-TeX},
  }%
}

\makeatother

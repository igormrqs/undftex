\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{src/core/undf-toccore}[2026/01/01 UnDF-TeX toc core]

\RequirePackage{titletoc}

% ----------------------------------------------------
% Margem comum do sumário
% ----------------------------------------------------
\contentsmargin{2.5em}

% ----------------------------------------------------
% Sumário
% ----------------------------------------------------
\titlecontents{chapter}
  [0em]
  {\bfseries}
  {\contentslabel{2.3em}}
  {}
  {\hfill\contentspage}

\titlecontents{section}
  [2.3em]
  {\bfseries}
  {\contentslabel{2.8em}}
  {}
  {\hfill\contentspage}

\titlecontents{subsection}
  [5.1em]
  {\normalfont}
  {\contentslabel{3.3em}}
  {}
  {\hfill\contentspage}

\titlecontents{subsubsection}
  [8.4em]
  {\normalfont}
  {\contentslabel{3.8em}}
  {}
  {\hfill\contentspage}

\titlecontents{paragraph}
  [12.2em]
  {\itshape}
  {\contentslabel{4.2em}}
  {}
  {\hfill\contentspage}

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{src/core/undf-layout}[2026/01/01 UnDF-TeX layout]

% ----------------------------------------------------
% Margens do documento
% ----------------------------------------------------
\RequirePackage{geometry}

\geometry{
  a4paper,
  left=3cm,
  right=2cm,
  top=3cm,
  bottom=2cm
}

% ----------------------------------------------------
% Espaçamento entre linhas
% ----------------------------------------------------
\RequirePackage{setspace}
\onehalfspacing

% ----------------------------------------------------
% Recuo também no primeiro parágrafo após títulos
% ----------------------------------------------------
\RequirePackage{indentfirst}

% ----------------------------------------------------
% Recuo de parágrafo
% ----------------------------------------------------
\setlength{\parindent}{1.25cm}

% ----------------------------------------------------
% Paginação textual e pós-textual
% ----------------------------------------------------
\RequirePackage{fancyhdr}

% Valor ajustado para eliminar warning do fancyhdr
\setlength{\headheight}{15pt}

\fancypagestyle{undftextual}{
  \fancyhf{}
  \fancyhead[R]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}

\fancypagestyle{plain}{
  \fancyhf{}
  \fancyhead[R]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}

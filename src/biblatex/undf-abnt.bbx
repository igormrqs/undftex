\ProvidesFile{undf-abnt.bbx}[2026/04/11 UnDF bibliography style]

\RequireBibliographyStyle{standard}

% ----------------------------------------------------
% Formatação de campos bibliográficos
% ----------------------------------------------------
\DeclareFieldFormat[article,incollection,inbook]{title}{#1}
\DeclareFieldFormat[article,incollection,inbook]{pages}{#1}
\DeclareFieldFormat[misc]{pages}{#1}
\DeclareFieldFormat[online,misc,report,thesis]{title}{#1}

% ----------------------------------------------------
% Formatação de URL sem espaçamento artificial
% ----------------------------------------------------
\DeclareFieldFormat{url}{%
  \begingroup
    \urlstyle{same}%
    \Urlmuskip=0mu\relax
    \url{#1}%
  \endgroup}

% ----------------------------------------------------
% Bibliografia sem marcador visual
% ----------------------------------------------------
\defbibenvironment{bibliography}
  {\list{}%
     {%
       \setlength{\leftmargin}{0pt}%
       \setlength{\rightmargin}{0pt}%
       \setlength{\labelwidth}{0pt}%
       \setlength{\labelsep}{0pt}%
       \setlength{\itemindent}{0pt}%
       \setlength{\listparindent}{0pt}%
       \setlength{\itemsep}{\baselineskip}%
       \setlength{\parsep}{0pt}%
       \setlength{\topsep}{0pt}%
       \setlength{\partopsep}{0pt}%
       \setlength{\parindent}{0pt}%
       \setlength{\parskip}{0pt}%
     }%
   \singlespacing
   \setlength{\parindent}{0pt}%
   \setlength{\parskip}{0pt}%
   \setlength{\leftskip}{0pt}%
   \setlength{\rightskip}{0pt}%
   \setlength{\parfillskip}{0pt plus 1fil}%
   \hangindent=0pt\relax
   \hangafter=1\relax
   \everypar{}%
   \emergencystretch=3em\relax
   \fussy
  }
  {\endlist}
  {\item\relax}

% ----------------------------------------------------
% Formato institucional de nomes
% ----------------------------------------------------
\DeclareNameAlias{undf:family-given}{family-given}

\newcommand*{\undf@upperbibnames}{%
  \renewcommand*{\mkbibnamefamily}[1]{\MakeUppercase{##1}}%
  \renewcommand*{\mkbibnameprefix}[1]{\MakeUppercase{##1}}%
}

% ----------------------------------------------------
% Macros auxiliares da bibliografia
% ----------------------------------------------------
% Qualificadores sao fornecidos pelo autor (EDTF), nunca inferidos pelo estilo.
\DefineBibliographyStrings{portuguese}{circa={ca\adddot}}
\DeclareFieldFormat{date}{%
  \ifboolexpr{test {\ifdatecirca} or test {\ifdateuncertain}
    or test {\iffieldequalstr{labelyear}{nodate}}}
    {\mkbibbrackets{#1}}{#1}%
}
\DeclareFieldAlias{labeldate}{date}

% Monografias/relatorios usam anos; artigo, online, legislacao e defesa preservam precisao.
\newbibmacro*{undf:pubdate}[1][year]{%
  \iffieldundef{year}
    {\printlabeldateextra}
    {\ifstrequal{#1}{year}{\mkdaterangeyearextra{}}{\printdateextra}}%
}
\renewbibmacro*{date}{\usebibmacro{undf:pubdate}[full]}

\newbibmacro*{undf:mainauthor}{%
  \ifnameundef{author}
    {%
      \iflistundef{organization}
        {%
          \ifnameundef{editor}
            {}
            {{\undf@upperbibnames\printnames[undf:family-given]{editor}}}%
        }
        {\printlist{organization}}%
    }
    {{\undf@upperbibnames\printnames[undf:family-given]{author}}}%
}

\newbibmacro*{undf:containerauthor}{%
  \ifnameundef{editor}
    {%
      \ifnameundef{bookauthor}
        {}
        {{\undf@upperbibnames\printnames[undf:family-given]{bookauthor}}}%
    }
    {{\undf@upperbibnames\printnames[undf:family-given]{editor}}}%
}

\newbibmacro*{undf:title}{%
  \printfield{title}%
  \iffieldundef{subtitle}
    {}
    {\setunit{\addcolon\space}\printfield{subtitle}}%
}

\newbibmacro*{undf:edition}{%
  \iffieldundef{edition}
    {}
    {\printfield{edition}}%
}

\newbibmacro*{undf:imprenta}[1][publisher]{%
  \iflistundef{location}
    {}
    {%
      \printlist{location}%
      \iflistundef{#1}
        {}
        {\addcolon\space}%
    }%
  \iflistundef{#1}
    {}
    {\printlist{#1}}%
  \ifboolexpr{test {\iflistundef{location}} and test {\iflistundef{#1}}}
    {}{\setunit{\addcomma\space}}%
  \usebibmacro{undf:pubdate}%
}

\newbibmacro*{undf:journalinfo}{%
  \printfield{journaltitle}%
  \iflistundef{location}
    {}
    {\addcomma\space\printlist{location}}%
  \iffieldundef{volume}
    {}
    {\addcomma\space v\adddot\space\printfield{volume}}%
  \iffieldundef{number}
    {}
    {\addcomma\space n\adddot\space\printfield{number}}%
  \iffieldundef{pages}
    {}
    {\addcomma\space p\adddot\space\printfield{pages}}%
  \setunit{\addcomma\space}%
  \usebibmacro{undf:pubdate}[full]%
}

\newbibmacro*{undf:urlaccess}{%
  \iffieldundef{url}
    {\ifentrytype{online}
      {\PackageWarningNoLine{undf-biblatex}{URL ausente: \thefield{entrykey}. Informe o endereco consultado quando disponivel}}{}}%
    {%
      \adddot\par
      % O grupo de cada entrada limita o alinhamento a este bloco final.
      \raggedright\noindent Disponível em:\space\printfield{url}%
      \iffieldundef{urlyear}
        {\PackageWarningNoLine{undf-biblatex}{Acesso ausente: \thefield{entrykey}. Informe a data real de consulta}}
        {\adddot}%
    }%
  \iffieldundef{urlyear}
    {}
    {%
      \iffieldundef{url}
        {\PackageWarningNoLine{undf-biblatex}{Acesso sem URL: \thefield{entrykey}. Confira o endereco associado a data informada}}{}%
      \ifboolexpr{test {\iffieldundef{urlmonth}} or test {\iffieldundef{urlday}}}
        {\PackageWarningNoLine{undf-biblatex}{Acesso parcial: \thefield{entrykey}. Confira dia, mes e ano sem completar dados por suposicao}}{}%
      \par\noindent Acesso em:\space
      {\DeclareFieldFormat{urldate}{##1}\mkdaterangelong{url}}%
    }%
}

% Somente igualdade literal com um resolvedor conhecido permite unir DOI e URL.
% Consultas, fragmentos e outros enderecos permanecem distintos; nao ha rede.
\ExplSyntaxOn
\cs_new_protected:Npn \undf@ifdoiurlTF #1#2
  {
    \str_if_eq:eeTF {\thefield{url}} {https://doi.org/\thefield{doi}} {#1}
      {\str_if_eq:eeTF {\thefield{url}} {http://doi.org/\thefield{doi}} {#1}
        {\str_if_eq:eeTF {\thefield{url}} {https://dx.doi.org/\thefield{doi}} {#1}
          {\str_if_eq:eeTF {\thefield{url}} {http://dx.doi.org/\thefield{doi}} {#1} {#2}}}}
  }
\ExplSyntaxOff

% Bloco compartilhado com os drivers herdados, preservando formatos e opcoes nativos.
\renewbibmacro*{doi+eprint+url}{%
  \iftoggle{bbx:doi}
    {\iftoggle{bbx:url}
      {\undf@ifdoiurlTF{}{\printfield{doi}}}
      {\printfield{doi}}}{}%
  \newunit\newblock
  \iftoggle{bbx:eprint}{\usebibmacro{eprint}}{}%
  \newunit\newblock
  \iftoggle{bbx:url}{\usebibmacro{undf:urlaccess}}{}%
}

\newbibmacro*{undf:electronic}{%
  \newunit\newblock
  \printfield{howpublished}%
  \newunit\newblock
  \usebibmacro{doi+eprint+url}%
}

\newbibmacro*{undf:legisource}{%
  \printfield{journaltitle}%
  \iflistundef{location}
    {}
    {\addcomma\space\printlist{location}}%
  \setunit{\addcomma\space}%
  \usebibmacro{undf:pubdate}[full]%
  \iffieldundef{pages}
    {}
    {\addcomma\space p\adddot\space\printfield{pages}}%
}

% ----------------------------------------------------
% Drivers bibliográficos
% ----------------------------------------------------
\DeclareBibliographyDriver{book}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \newunit\newblock
  \usebibmacro{undf:edition}%
  \newunit\newblock
  \usebibmacro{undf:imprenta}%
  \usebibmacro{undf:electronic}%
  \finentry
}

\DeclareBibliographyDriver{mvbook}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \newunit\newblock
  \usebibmacro{undf:edition}%
  \newunit\newblock
  \usebibmacro{undf:imprenta}%
  \usebibmacro{undf:electronic}%
  \finentry
}

\DeclareBibliographyDriver{collection}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \newunit\newblock
  \usebibmacro{undf:edition}%
  \newunit\newblock
  \usebibmacro{undf:imprenta}%
  \usebibmacro{undf:electronic}%
  \finentry
}

\DeclareBibliographyDriver{mvcollection}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \newunit\newblock
  \usebibmacro{undf:edition}%
  \newunit\newblock
  \usebibmacro{undf:imprenta}%
  \usebibmacro{undf:electronic}%
  \finentry
}

\DeclareBibliographyDriver{article}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \adddot\space
  \usebibmacro{undf:journalinfo}%
  \usebibmacro{undf:electronic}%
  \finentry
}

\DeclareBibliographyDriver{incollection}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \adddot\space
  In\addcolon\space
  \usebibmacro{undf:containerauthor}%
  \setunit{\adddot\space}%
  \printfield{booktitle}%
  \newunit\newblock
  \usebibmacro{undf:edition}%
  \newunit\newblock
  \usebibmacro{undf:imprenta}%
  \iffieldundef{pages}
    {}
    {\addcomma\space p\adddot\space\printfield{pages}}%
  \usebibmacro{undf:electronic}%
  \finentry
}

\DeclareBibliographyDriver{inbook}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \adddot\space
  In\addcolon\space
  \usebibmacro{undf:containerauthor}%
  \setunit{\adddot\space}%
  \printfield{booktitle}%
  \newunit\newblock
  \usebibmacro{undf:edition}%
  \newunit\newblock
  \usebibmacro{undf:imprenta}%
  \iffieldundef{pages}
    {}
    {\addcomma\space p\adddot\space\printfield{pages}}%
  \usebibmacro{undf:electronic}%
  \finentry
}

% ----------------------------------------------------
% Documentos online
% ----------------------------------------------------
\DeclareBibliographyDriver{online}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \newunit\newblock
  \iflistundef{location}
    {}
    {\printlist{location}}%
  \iflistundef{publisher}
    {}
    {%
      \iflistundef{location}
        {}
        {\addcolon\space}%
      \printlist{publisher}%
    }%
  \ifboolexpr{test {\iflistundef{location}} and test {\iflistundef{publisher}}}
    {}{\setunit{\addcomma\space}}%
  \usebibmacro{undf:pubdate}[full]%
  \usebibmacro{undf:electronic}%
  \finentry
}

% ----------------------------------------------------
% Trabalhos acadêmicos
% ----------------------------------------------------
\DeclareBibliographyDriver{thesis}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \iffieldundef{type}
    {}
    {\adddot\space\printfield{type}}%
  \iflistundef{institution}
    {}
    {\addcomma\space\printlist{institution}}%
  \iflistundef{location}
    {}
    {\addcomma\space\printlist{location}}%
  \setunit{\addcomma\space}%
  \usebibmacro{undf:pubdate}[full]%
  \usebibmacro{undf:electronic}%
  \finentry
}

% ----------------------------------------------------
% Relatórios e documentos institucionais
% ----------------------------------------------------
\DeclareBibliographyDriver{report}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \iffieldundef{type}
    {}
    {\adddot\space\printfield{type}}%
  \iffieldundef{number}
    {}
    {\addcomma\space n\adddot\space\printfield{number}}%
  \newunit\newblock
  % Instituicao responsavel nao e promovida a autora. Listas identicas
  % de instituicao/editora aparecem uma vez no bloco de publicacao.
  \iflistundef{publisher}
    {\usebibmacro{undf:imprenta}[institution]}
    {%
      \iflistundef{institution}
        {}
        {\iflistsequal{institution}{publisher}
          {}
          {\printlist{institution}\newunit\newblock}}%
      \usebibmacro{undf:imprenta}%
    }%
  \usebibmacro{undf:electronic}%
  \finentry
}

% ----------------------------------------------------
% Documento jurídico - legislação
% ----------------------------------------------------
\DeclareBibliographyDriver{legislation}{%
  \usebibmacro{begentry}%
  \printnames{author}%
  \setunit{\adddot\space}%
  \printfield[titlecase]{title}%
  \iffieldundef{subtitle}
    {}
    {\setunit{\addcolon\space}\printfield[titlecase]{subtitle}}%
  \setunit{\adddot\space}%
  \printfield{journaltitle}%
  \iflistundef{location}
    {}
    {\setunit{\addcomma\space}\printlist{location}}%
  \setunit{\addcomma\space}%
  \usebibmacro{undf:pubdate}[full]%
  \iffieldundef{pages}
    {}
    {\setunit{\addcomma\space}\printfield{pages}}%
  \usebibmacro{undf:electronic}%
  \usebibmacro{finentry}%
}

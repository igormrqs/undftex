\ProvidesFile{undf-abnt.bbx}[2026/04/11 UnDF bibliography style]

\RequireBibliographyStyle{standard}

% ----------------------------------------------------
% Formatação de campos bibliográficos
% ----------------------------------------------------
% A entrada pelo titulo nao muda os dados nem recebe destaque tipografico.
\ExplSyntaxOn
\clist_const:Nx \c_undf_articles_clist {\tl_to_str:n {a,as,o,os,um,uma,uns,umas,the,an}}
\cs_new_protected:Npn \undf_simple_entry_title:n #1
  {
    \clist_set_eq:NN \l_tmpa_clist \c_undf_articles_clist
    \iffieldequalstr{langid}{english}{}
      {\clist_remove_all:Nn \l_tmpa_clist {the}
       \clist_remove_all:Nn \l_tmpa_clist {an}}
    \seq_set_split:Nnn \l_tmpa_seq { ~ } {#1}
    \seq_pop_left:NN \l_tmpa_seq \l_tmpa_tl
    \tl_set:Nx \l_tmpb_tl {\str_lowercase:f {\tl_to_str:V \l_tmpa_tl}}
    \exp_args:NNV \clist_if_in:NnT \l_tmpa_clist \l_tmpb_tl
      {\seq_if_empty:NF \l_tmpa_seq
        {\seq_pop_left:NN \l_tmpa_seq \l_tmpb_tl
         \tl_put_right:Nx \l_tmpa_tl { ~ \exp_not:V \l_tmpb_tl}}}
    \exp_args:NV \MakeUppercase \l_tmpa_tl
    \seq_if_empty:NF \l_tmpa_seq { ~ \seq_use:Nn \l_tmpa_seq { ~ }}
  }

% Grupos e comandos conservam sua estrutura e caixa; nao sao interpretados.
\cs_new_protected:Npn \undf_entry_title:n #1
  {
    \exp_args:Nne \regex_match:nnTF { [\{\}\\\$\^_] | \x{7E} | [a-z][A-Z] } {\tl_to_str:n {#1}}
      {\PackageWarningNoLine{undf-biblatex}{Titulo protegido: \thefield{entrykey}. Caixa preservada; confira shorttitle e apresentacao editorial}#1}
      {\iffieldundef{langid}
         {\regex_match:nnTF {(?i)\A(?:The|An)\s} {#1}
            {#1}{\undf_simple_entry_title:n {#1}}}
         {\ifboolexpr{test {\iffieldequalstr{langid}{english}}
             or test {\iffieldequalstr{langid}{portuguese}}}
            {\undf_simple_entry_title:n {#1}}{#1}}}
  }
\cs_new_eq:NN \undf@entrytitle \undf_entry_title:n
\ExplSyntaxOff
\DeclareFieldFormat{undf:entrytitle}{\undf@entrytitle{#1}}
\DeclareFieldFormat{title}{\ifnameundef{labelname}{#1}{\mkbibemph{#1}}}
\DeclareFieldFormat[article,incollection,inbook]{title}{#1}
\DeclareFieldFormat[article,incollection,inbook]{pages}{#1}
\DeclareFieldFormat[misc]{pages}{#1}
\DeclareFieldFormat[online,misc,report,thesis]{title}{#1}

% ----------------------------------------------------
% Formatação de URL sem espaçamento artificial
% ----------------------------------------------------
\DeclareFieldFormat{url}{%
  \begingroup
    \urlstyle{same}%
    \Urlmuskip=0mu\relax
    \url{#1}%
  \endgroup}

% ----------------------------------------------------
% Bibliografia sem marcador visual
% ----------------------------------------------------
\defbibenvironment{bibliography}
  {\list{}%
     {%
       \setlength{\leftmargin}{0pt}%
       \setlength{\rightmargin}{0pt}%
       \setlength{\labelwidth}{0pt}%
       \setlength{\labelsep}{0pt}%
       \setlength{\itemindent}{0pt}%
       \setlength{\listparindent}{0pt}%
       \setlength{\itemsep}{\baselineskip}%
       \setlength{\parsep}{0pt}%
       \setlength{\topsep}{0pt}%
       \setlength{\partopsep}{0pt}%
       \setlength{\parindent}{0pt}%
       \setlength{\parskip}{0pt}%
     }%
   \singlespacing
   \setlength{\parindent}{0pt}%
   \setlength{\parskip}{0pt}%
   \setlength{\leftskip}{0pt}%
   \setlength{\rightskip}{0pt}%
   \setlength{\parfillskip}{0pt plus 1fil}%
   \hangindent=0pt\relax
   \hangafter=1\relax
   \everypar{}%
   \emergencystretch=3em\relax
   \fussy
  }
  {\endlist}
  {\item\relax}

% ----------------------------------------------------
% Formato institucional de nomes
% ----------------------------------------------------
\DeclareNameAlias{undf:family-given}{family-given}

\newcommand*{\undf@upperbibnames}{%
  \renewcommand*{\mkbibnamefamily}[1]{\MakeUppercase{##1}}%
  \renewcommand*{\mkbibnameprefix}[1]{\MakeUppercase{##1}}%
}

% ----------------------------------------------------
% Macros auxiliares da bibliografia
% ----------------------------------------------------
% Qualificadores sao fornecidos pelo autor (EDTF), nunca inferidos pelo estilo.
\NewBibliographyString{coordinator,coordinators,bycoordinator}
\DefineBibliographyStrings{portuguese}{%
  circa={ca\adddot},
  editors={ed\adddot},
  organizers={org\adddot},
  coordinator={coord\adddot},
  coordinators={coord\adddot},
  bycoordinator={coord\adddotspace por}%
}
\DeclareFieldFormat{date}{%
  \ifboolexpr{test {\ifdatecirca} or test {\ifdateuncertain}
    or test {\iffieldequalstr{labelyear}{nodate}}}
    {\mkbibbrackets{#1}}{#1}%
}
\DeclareFieldAlias{labeldate}{date}

% Monografias/relatorios usam anos; artigo, online, legislacao e defesa preservam precisao.
\newbibmacro*{undf:pubdate}[1][year]{%
  \iffieldundef{year}
    {\printlabeldateextra}
    {\ifstrequal{#1}{year}{\mkdaterangeyearextra{}}{\printdateextra}}%
}
\renewbibmacro*{date}{\usebibmacro{undf:pubdate}[full]}

\newbibmacro*{undf:checkeditorrole}{%
  \iffieldundef{editortype}{}%
    {\ifbibxstring{\thefield{editortype}}{}%
      {\PackageWarningNoLine{undf-biblatex}{Funcao editorial literal: \thefield{entrykey}. Confira editortype; o valor informado sera preservado}}}%
}

\newbibmacro*{undf:editor}{%
  \ifnameundef{editor}{}%
    {{\undf@upperbibnames\printnames[undf:family-given]{editor}}%
     \setunit{\addspace}%
     \usebibmacro{undf:checkeditorrole}%
     \printtext[parens]{\usebibmacro{editorstrg}}}%
}

\newbibmacro*{undf:byeditor}{%
  \ifnameundef{editor}{}%
    {\newunit\newblock
     \usebibmacro{undf:checkeditorrole}%
     \usebibmacro{byeditor}}%
}

\newbibmacro*{undf:secondaryeditor}{%
  \ifnameundef{author}{}{\usebibmacro{undf:byeditor}}%
}

\newbibmacro*{undf:containereditor}{%
  \ifnameundef{bookauthor}{}{\usebibmacro{undf:byeditor}}%
}

\newbibmacro*{undf:mainauthor}{%
  \ifnameundef{author}
    {\ifuseeditor{\usebibmacro{undf:editor}}{}}
    {{\undf@upperbibnames\printnames[undf:family-given]{author}}}%
}

\newbibmacro*{undf:containerauthor}{%
  \ifnameundef{bookauthor}
    {\usebibmacro{undf:editor}}
    {{\undf@upperbibnames\printnames[undf:family-given]{bookauthor}}}%
}

\newbibmacro*{undf:title}{%
  \ifnameundef{labelname}
    {\printfield[undf:entrytitle]{title}}
    {\printfield{title}}%
  \iffieldundef{subtitle}
    {}
    {\iffieldundef{title}{}{\setunit{\addcolon\space}}\printfield{subtitle}}%
}
\letbibmacro{undf:native-title}{title}
\renewbibmacro*{title}{%
  \ifnameundef{labelname}
    {\usebibmacro{undf:title}\newunit\printfield{titleaddon}}
    {\usebibmacro{undf:native-title}}%
}

\newbibmacro*{undf:edition}{%
  \iffieldundef{edition}
    {}
    {\printfield{edition}}%
}

\newbibmacro*{undf:maintitle+title}{%
  % Somente pares inteiros iguais representam uma repeticao do mesmo titulo.
  \ifboolexpr{test {\iffieldsequal{maintitle}{title}} and
    (test {\iffieldsequal{mainsubtitle}{subtitle}} or
      (test {\iffieldundef{mainsubtitle}} and test {\iffieldundef{subtitle}}))}
    {\clearfield{maintitle}\clearfield{mainsubtitle}}{}%
  \ifnameundef{labelname}{\usebibmacro{undf:title}\newunit\newblock}{}%
  \iffieldundef{maintitle}{}%
    {\printtext{\renewcommand*{\subtitlepunct}{\addcolon\space}\usebibmacro{maintitle}}%
     \newunit\newblock
     \iffieldundef{volume}{}%
       {\printfield{volume}\printfield{part}\setunit{\addcolon\space}}}%
  \ifnameundef{labelname}{}{\usebibmacro{undf:title}}%
}

\newbibmacro*{undf:volume}{%
  \iffieldundef{maintitle}
    {\iffieldundef{volume}{}{\printfield{volume}\printfield{part}}}{}%
}

\newbibmacro*{undf:imprenta}[1][publisher]{%
  \iflistundef{location}
    {}
    {%
      \printlist{location}%
      \iflistundef{#1}
        {}
        {\addcolon\space}%
    }%
  \iflistundef{#1}
    {}
    {\printlist{#1}}%
  \ifboolexpr{test {\iflistundef{location}} and test {\iflistundef{#1}}}
    {}{\setunit{\addcomma\space}}%
  \usebibmacro{undf:pubdate}%
}

\DeclareFieldFormat{undf:journalvolume}{v\adddot\space#1}
\DeclareFieldFormat{undf:journalnumber}{n\adddot\space#1}
\DeclareFieldFormat{undf:journalpages}{p\adddot\space#1}
\DeclareFieldFormat{undf:articleeid}{%
  \begingroup
    \urlstyle{same}%
    \Urlmuskip=0mu\relax
    \nolinkurl{#1}%
  \endgroup}
\newbibmacro*{undf:journalinfo}{%
  \iffieldundef{eid}{}{\iffieldundef{pages}{}{%
    \PackageWarningNoLine{undf-biblatex}{Localizador e paginas simultaneos: \thefield{entrykey}. Confira as funcoes na fonte; ambos os campos foram preservados}}}%
  \printfield{journaltitle}%
  \iffieldundef{journalsubtitle}{}%
    {\iffieldundef{journaltitle}{}{\setunit{\addcolon\space}}%
     \printfield{journalsubtitle}}%
  \setunit*{\addcomma\space}\printlist{location}%
  \setunit*{\addcomma\space}\printfield[undf:journalvolume]{volume}%
  \setunit*{\addcomma\space}\printfield[undf:journalnumber]{number}%
  \setunit*{\addcomma\space}\printfield[undf:articleeid]{eid}%
  \setunit*{\addcomma\space}\printfield[undf:journalpages]{pages}%
  \setunit*{\addcomma\space}%
  \usebibmacro{undf:pubdate}[full]%
}

% Diagnosticos de revisao, sem completar dados nem impedir a compilacao.
\newcommand*{\undf@missingessential}[1]{%
  \PackageWarningNoLine{undf-biblatex}{Essencial ausente: \thefield{entrykey} (#1). Confira a fonte; nenhum valor sera inferido}}
\newbibmacro*{undf:checkimprint}{%
  \iflistundef{publisher}{\undf@missingessential{publisher}}{}%
  \iflistundef{location}{\undf@missingessential{location}}{}%
}
\newbibmacro*{undf:checkessential}{%
  \iffieldundef{title}{\undf@missingessential{title}}{}%
  \ifentrytype{article}
    {\iffieldundef{journaltitle}{\undf@missingessential{journaltitle}}{}%
     \iflistundef{location}{\undf@missingessential{location}}{}}{}%
  \ifboolexpr{test {\ifentrytype{book}} or test {\ifentrytype{mvbook}}
    or test {\ifentrytype{collection}} or test {\ifentrytype{mvcollection}}
    or test {\ifentrytype{reference}} or test {\ifentrytype{mvreference}}}
    {\usebibmacro{undf:checkimprint}}{}%
  \ifboolexpr{test {\ifentrytype{inbook}} or test {\ifentrytype{incollection}}
    or test {\ifentrytype{bookinbook}} or test {\ifentrytype{inreference}}
    or test {\ifentrytype{suppbook}} or test {\ifentrytype{suppcollection}}}
    {\iffieldundef{booktitle}{\undf@missingessential{booktitle}}{}%
     \usebibmacro{undf:checkimprint}%
     \ifboolexpr{test {\iffieldundef{pages}} and test {\iffieldundef{volume}}}
       {\undf@missingessential{pages/volume}}{}}{}%
  \ifboolexpr{test {\ifentrytype{thesis}} or test {\ifentrytype{mastersthesis}}
    or test {\ifentrytype{phdthesis}}}
    {\iffieldundef{type}{\undf@missingessential{type}}{}%
     \iflistundef{institution}{\undf@missingessential{institution}}{}%
     \iflistundef{location}{\undf@missingessential{location}}{}}{}%
  \ifboolexpr{(test {\ifentrytype{report}} or test {\ifentrytype{techreport}})
    and test {\iflistundef{publisher}} and test {\iflistundef{institution}}}
    {\undf@missingessential{publisher/institution}}{}%
}
\letbibmacro{undf:native-begentry}{begentry}
\renewbibmacro*{begentry}{%
  \usebibmacro{undf:native-begentry}\usebibmacro{undf:checkessential}}

\newbibmacro*{undf:urlaccess}{%
  \iffieldundef{url}
    {\ifentrytype{online}
      {\PackageWarningNoLine{undf-biblatex}{URL ausente: \thefield{entrykey}. Informe o endereco consultado quando disponivel}}{}}%
    {%
      \adddot\par
      % O grupo de cada entrada limita o alinhamento a este bloco final.
      \raggedright\noindent Disponível em:\space\printfield{url}%
      \iffieldundef{urlyear}
        {\PackageWarningNoLine{undf-biblatex}{Acesso ausente: \thefield{entrykey}. Informe a data real de consulta}}
        {\adddot}%
    }%
  \iffieldundef{urlyear}
    {}
    {%
      \iffieldundef{url}
        {\PackageWarningNoLine{undf-biblatex}{Acesso sem URL: \thefield{entrykey}. Confira o endereco associado a data informada}}{}%
      \ifboolexpr{test {\iffieldundef{urlmonth}} or test {\iffieldundef{urlday}}}
        {\PackageWarningNoLine{undf-biblatex}{Acesso parcial: \thefield{entrykey}. Confira dia, mes e ano sem completar dados por suposicao}}{}%
      \par\noindent Acesso em:\space
      {\DeclareFieldFormat{urldate}{##1}\mkdaterangelong{url}}%
    }%
}

% Somente igualdade literal com um resolvedor conhecido permite unir DOI e URL.
% Consultas, fragmentos e outros enderecos permanecem distintos; nao ha rede.
\ExplSyntaxOn
\cs_new_protected:Npn \undf@ifdoiurlTF #1#2
  {
    \str_if_eq:eeTF {\thefield{url}} {https://doi.org/\thefield{doi}} {#1}
      {\str_if_eq:eeTF {\thefield{url}} {http://doi.org/\thefield{doi}} {#1}
        {\str_if_eq:eeTF {\thefield{url}} {https://dx.doi.org/\thefield{doi}} {#1}
          {\str_if_eq:eeTF {\thefield{url}} {http://dx.doi.org/\thefield{doi}} {#1} {#2}}}}
  }
\ExplSyntaxOff

% Bloco compartilhado com os drivers herdados, preservando formatos e opcoes nativos.
\renewbibmacro*{doi+eprint+url}{%
  \iftoggle{bbx:doi}
    {\iftoggle{bbx:url}
      {\undf@ifdoiurlTF{}{\printfield{doi}}}
      {\printfield{doi}}}{}%
  \newunit\newblock
  \iftoggle{bbx:eprint}{\usebibmacro{eprint}}{}%
  \newunit\newblock
  \iftoggle{bbx:url}{\usebibmacro{undf:urlaccess}}{}%
}

% Igualdade literal com informacao ja impressa nao acrescenta outra nota.
% type identifica a natureza somente nos drivers de relatorio/trabalho academico.
\newcommand*{\undf@clearduplicatematerial}[1]{%
  \ifboolexpr{test {\iffieldsequal{#1}{title}}
    or test {\iffieldsequal{#1}{subtitle}}
    or test {\iffieldsequal{#1}{howpublished}}
    or ((test {\ifentrytype{report}} or test {\ifentrytype{techreport}}
      or test {\ifentrytype{thesis}} or test {\ifentrytype{mastersthesis}}
      or test {\ifentrytype{phdthesis}})
      and test {\iffieldsequal{#1}{type}})}
    {\clearfield{#1}}{}%
}
\newbibmacro*{undf:materialnotes}{%
  \begingroup
  \forcsvlist{\undf@clearduplicatematerial}{note,addendum,pubstate}%
  \iffieldsequal{addendum}{note}{\clearfield{addendum}}{}%
  \iffieldsequal{pubstate}{note}{\clearfield{pubstate}}{}%
  \iffieldsequal{pubstate}{addendum}{\clearfield{pubstate}}{}%
  \printfield{note}%
  \newunit\newblock
  \usebibmacro{addendum+pubstate}%
  \endgroup
}

\newbibmacro*{undf:electronic}{%
  \newunit\newblock
  \printfield{howpublished}%
  \newunit\newblock
  \usebibmacro{undf:materialnotes}%
  \newunit\newblock
  \usebibmacro{doi+eprint+url}%
}

\newbibmacro*{undf:legisource}{%
  \printfield{journaltitle}%
  \iflistundef{location}
    {}
    {\addcomma\space\printlist{location}}%
  \setunit{\addcomma\space}%
  \usebibmacro{undf:pubdate}[full]%
  \iffieldundef{pages}
    {}
    {\addcomma\space p\adddot\space\printfield{pages}}%
}

% ----------------------------------------------------
% Drivers bibliográficos
% ----------------------------------------------------
\DeclareBibliographyDriver{book}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:maintitle+title}%
  \usebibmacro{undf:secondaryeditor}%
  \newunit\newblock\usebibmacro{bytranslator}%
  \newunit\newblock
  \usebibmacro{undf:edition}%
  \newunit\newblock
  \usebibmacro{undf:volume}%
  \newunit\newblock
  \usebibmacro{undf:imprenta}%
  \usebibmacro{undf:electronic}%
  \finentry
}

\DeclareBibliographyDriver{mvbook}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:maintitle+title}%
  \usebibmacro{undf:secondaryeditor}%
  \newunit\newblock\usebibmacro{bytranslator}%
  \newunit\newblock
  \usebibmacro{undf:edition}%
  \newunit\newblock
  \usebibmacro{undf:volume}%
  \newunit\newblock
  \usebibmacro{undf:imprenta}%
  \usebibmacro{undf:electronic}%
  \finentry
}

\DeclareBibliographyDriver{collection}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:maintitle+title}%
  \usebibmacro{undf:secondaryeditor}%
  \newunit\newblock\usebibmacro{bytranslator}%
  \newunit\newblock
  \usebibmacro{undf:edition}%
  \newunit\newblock
  \usebibmacro{undf:volume}%
  \newunit\newblock
  \usebibmacro{undf:imprenta}%
  \usebibmacro{undf:electronic}%
  \finentry
}

\DeclareBibliographyDriver{mvcollection}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:maintitle+title}%
  \usebibmacro{undf:secondaryeditor}%
  \newunit\newblock\usebibmacro{bytranslator}%
  \newunit\newblock
  \usebibmacro{undf:edition}%
  \newunit\newblock
  \usebibmacro{undf:volume}%
  \newunit\newblock
  \usebibmacro{undf:imprenta}%
  \usebibmacro{undf:electronic}%
  \finentry
}

\DeclareBibliographyDriver{article}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \newunit\newblock\usebibmacro{bytranslator}%
  \newunit\newblock
  \usebibmacro{undf:journalinfo}%
  \usebibmacro{undf:electronic}%
  \finentry
}

\DeclareBibliographyDriver{incollection}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \newunit\newblock\usebibmacro{bytranslator}%
  \setunit{\adddot\space}%
  \printtext{In\addcolon\space}%
  \usebibmacro{undf:containerauthor}%
  \setunit{\adddot\space}%
  \printtext{\renewcommand*{\subtitlepunct}{\addcolon\space}\usebibmacro{maintitle+booktitle}}%
  \usebibmacro{undf:containereditor}%
  \newunit\newblock
  \usebibmacro{undf:edition}%
  \newunit\newblock
  \usebibmacro{undf:volume}%
  \newunit\newblock
  \usebibmacro{undf:imprenta}%
  \iffieldundef{pages}
    {}
    {\addcomma\space p\adddot\space\printfield{pages}}%
  \usebibmacro{undf:electronic}%
  \finentry
}

\DeclareBibliographyDriver{inbook}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \newunit\newblock\usebibmacro{bytranslator}%
  \setunit{\adddot\space}%
  \printtext{In\addcolon\space}%
  \usebibmacro{undf:containerauthor}%
  \setunit{\adddot\space}%
  \printtext{\renewcommand*{\subtitlepunct}{\addcolon\space}\usebibmacro{maintitle+booktitle}}%
  \usebibmacro{undf:containereditor}%
  \newunit\newblock
  \usebibmacro{undf:edition}%
  \newunit\newblock
  \usebibmacro{undf:volume}%
  \newunit\newblock
  \usebibmacro{undf:imprenta}%
  \iffieldundef{pages}
    {}
    {\addcomma\space p\adddot\space\printfield{pages}}%
  \usebibmacro{undf:electronic}%
  \finentry
}

% ----------------------------------------------------
% Documentos online
% ----------------------------------------------------
\DeclareBibliographyDriver{online}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \newunit\newblock
  \iflistundef{location}
    {}
    {\printlist{location}}%
  \iflistundef{publisher}
    {}
    {%
      \iflistundef{location}
        {}
        {\addcolon\space}%
      \printlist{publisher}%
    }%
  \ifboolexpr{test {\iflistundef{location}} and test {\iflistundef{publisher}}}
    {}{\setunit{\addcomma\space}}%
  \usebibmacro{undf:pubdate}[full]%
  \usebibmacro{undf:electronic}%
  \finentry
}

% ----------------------------------------------------
% Trabalhos acadêmicos
% ----------------------------------------------------
% Datas adicionais sao explicitas: nao recebem fallback da publicacao ou acesso.
\DeclareFieldFormat[thesis]{type}{%
  \ifstrequal{#1}{mathesis}{Dissertação (Mestrado)}%
    {\ifstrequal{#1}{phdthesis}{Tese (Doutorado)}{#1}}}
\DeclareFieldFormat[thesis]{pagetotal}{%
  \ifboolexpr{test {\iffieldundef{bookpagination}} or test {\iffieldequalstr{bookpagination}{page}}}
    {#1\addspace p\adddot}%
    {\iffieldequalstr{bookpagination}{folio}{#1\addspace f\adddot}{\mkpagetotal[bookpagination]{#1}}}}
\DeclareFieldFormat{undfdepositdate}{%
  \ifboolexpr{test {\ifundfdepositdatecirca} or test {\ifundfdepositdateuncertain}}
    {\mkbibbrackets{#1}}{#1}}
\DeclareFieldFormat{undfdefensedate}{%
  \ifboolexpr{test {\ifundfdefensedatecirca} or test {\ifundfdefensedateuncertain}}
    {\mkbibbrackets{#1}}{#1}}
\newtoggle{undf:academicpubdate}
\newbibmacro*{undf:academicdate}[1]{%
  \iffieldundef{#1year}{}%
    {\ifdaterangesequal{#1}{}
       {\ifboolexpr{test {\ifstrequal{#1}{undfdeposit}}
          and test {\ifdaterangesequal{undfdefense}{}}}
          {\csuse{print#1date}}%
          {\toggletrue{undf:academicpubdate}\usebibmacro{undf:pubdate}[full]}}%
       {\csuse{print#1date}}}}
\newbibmacro*{undf:checkacademic}{%
  \ifnameundef{author}{\undf@missingessential{author}}{}%
  \iffieldundef{undfdeposityear}{\undf@missingessential{undfdepositdate}}{}%
  \iffieldundef{undfdefenseyear}{\undf@missingessential{undfdefensedate}}{}%
  \iffieldundef{type}{}%
    {\ifboolexpr{test {\iffieldequalstr{type}{mathesis}} or test {\iffieldequalstr{type}{phdthesis}}}
       {\PackageWarningNoLine{undf-biblatex}{Natureza academica incompleta: \thefield{entrykey}. Informe grau e curso completos em type}}%
       {\PackageWarningNoLine{undf-biblatex}{Natureza academica literal: \thefield{entrykey}. Confira grau e curso; texto preservado}}}%
  \ifboolexpr{not test {\iffieldundef{eventyear}} or not test {\iffieldundef{origyear}}}
    {\PackageWarningNoLine{undf-biblatex}{Data adicional sem papel academico: \thefield{entrykey}. eventdate/origdate nao identificam deposito ou defesa; confira os campos proprios ou uma nota explicita}}{}%
}
\DeclareBibliographyDriver{thesis}{%
  \usebibmacro{begentry}%
  \togglefalse{undf:academicpubdate}%
  \usebibmacro{undf:checkacademic}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \newunit\newblock
  \usebibmacro{undf:academicdate}{undfdeposit}%
  \newunit\newblock
  \printfield{pagetotal}%
  \newunit\newblock
  \usebibmacro{undf:volume}%
  \newunit\newblock
  \printfield{type}%
  \iflistundef{institution}{}%
    {\iffieldundef{type}{\newunit\newblock}{\setunit{\addspace\textendash\space}}%
     \printlist{institution}}%
  \setunit*{\addcomma\space}\printlist{location}%
  \setunit*{\addcomma\space}%
  \usebibmacro{undf:academicdate}{undfdefense}%
  \iftoggle{undf:academicpubdate}{}%
    {\newunit\newblock
     \printtext{Edição consultada\addcolon\space}\usebibmacro{undf:pubdate}[full]}%
  \usebibmacro{undf:electronic}%
  \finentry
}

% ----------------------------------------------------
% Relatórios e documentos institucionais
% ----------------------------------------------------
\DeclareBibliographyDriver{report}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \iffieldundef{type}
    {}
    {\adddot\space\printfield{type}}%
  \iffieldundef{number}
    {}
    {\addcomma\space n\adddot\space\printfield{number}}%
  \newunit\newblock
  % Instituicao responsavel nao e promovida a autora. Listas identicas
  % de instituicao/editora aparecem uma vez no bloco de publicacao.
  \iflistundef{publisher}
    {\usebibmacro{undf:imprenta}[institution]}
    {%
      \iflistundef{institution}
        {}
        {\iflistsequal{institution}{publisher}
          {}
          {\printlist{institution}\newunit\newblock}}%
      \usebibmacro{undf:imprenta}%
    }%
  \usebibmacro{undf:electronic}%
  \finentry
}

% ----------------------------------------------------
% Documento jurídico - legislação
% ----------------------------------------------------
% title e a epigrafe literal; number identifica o fasciculo, nao o ato.
\DeclareFieldFormat[legislation]{edition}{%
  \ifinteger{#1}{#1\adddot\addspace\bibstring{edition}}{#1\isdot}}
\DeclareFieldFormat[legislation]{pages}{p\adddot\space#1}
\DeclareFieldFormat[legislation]{pagetotal}{#1\addspace p\adddot}
\newbibmacro*{undf:checklegislation}{%
  \ifnameundef{author}{\undf@missingessential{author}}{}%
  \iffieldundef{subtitle}{\undf@missingessential{subtitle}}{}%
  \iflistundef{location}{\undf@missingessential{location}}{}%
  \PackageWarningNoLine{undf-biblatex}{Identificacao legal literal: \thefield{entrykey}. Confira jurisdicao em author e tipo, numero e data do ato em title; nenhum dado sera extraido ou inferido}%
  \iffieldundef{journaltitle}
    {\iflistundef{publisher}{\undf@missingessential{publisher}}{}%
     \iffieldundef{number}{}%
       {\PackageWarningNoLine{undf-biblatex}{Numero legal sem veiculo: \thefield{entrykey}. Confira number; valor preservado sem atribuir papel juridico}}}
    {\iffieldundef{number}
       {\PackageWarningNoLine{undf-biblatex}{Publicacao legal incompleta: \thefield{entrykey} (number). Confira se a fonte possui fasciculo}}{}%
     \iffieldundef{pages}
       {\PackageWarningNoLine{undf-biblatex}{Publicacao legal incompleta: \thefield{entrykey} (pages). Confira a paginacao da fonte}}{}%
     \iffieldundef{pagetotal}{}%
       {\PackageWarningNoLine{undf-biblatex}{Extensao legal nao aplicada ao diario: \thefield{entrykey}. pagetotal nao substitui pages}}%
     \iflistundef{publisher}{}%
       {\PackageWarningNoLine{undf-biblatex}{Editora legal no diario: \thefield{entrykey}. Confira o suporte; publisher preservado apos o local}}}%
  \iffieldundef{year}{}%
    {\ifboolexpr{not test {\iffieldundef{journaltitle}} and (test {\iffieldundef{month}} or test {\iffieldundef{day}})}
       {\PackageWarningNoLine{undf-biblatex}{Data legal parcial: \thefield{entrykey}. Confira a precisao da publicacao; nao sera completada pela epigrafe ou acesso}}{}}%
  \iffieldundef{booktitle}{}%
    {\PackageWarningNoLine{undf-biblatex}{Compilacao legal nao suportada: \thefield{entrykey}. booktitle exige referencia de parte conferida; preserve a identificacao em nota}}%
  \ifboolexpr{not test {\iflistundef{organization}} or not test {\iflistundef{institution}}}
    {\PackageWarningNoLine{undf-biblatex}{Entidade legal sem papel definido: \thefield{entrykey}. organization/institution nao substituem author; confira cabecalho literal ou nota}}{}%
}
\DeclareBibliographyDriver{legislation}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:checklegislation}%
  {\undf@upperbibnames\printnames[undf:family-given]{author}}%
  \setunit{\adddot\space}%
  \printfield[titlecase]{title}%
  \setunit{\adddot\space}\printfield[titlecase]{subtitle}%
  \newunit\newblock\printfield{titleaddon}%
  \newunit\newblock
  \iffieldundef{journaltitle}
    {\usebibmacro{undf:edition}\newunit\newblock
     \usebibmacro{publisher+location+date}%
     \newunit\newblock\printfield{pages}%
     \newunit\newblock\printfield{pagetotal}%
     \iffieldundef{number}{}%
       {\newunit\newblock\printtext{Número informado\addcolon\space}\printfield{number}}}
    {\printfield{journaltitle}%
     \iffieldundef{journalsubtitle}{}%
       {\setunit{\addcolon\space}\printfield{journalsubtitle}}%
     \setunit*{\addcomma\space}\printlist{location}%
     \iflistundef{publisher}{}%
       {\iflistundef{location}{\setunit{\addcomma\space}}{\setunit{\addcolon\space}}%
        \printlist{publisher}}%
     \setunit*{\addcomma\space}\printfield{series}%
     \setunit*{\addcomma\space}\printfield[undf:journalvolume]{volume}%
     \setunit*{\addcomma\space}\printfield[undf:journalnumber]{number}%
     \setunit*{\addcomma\space}\printfield{pages}%
     \setunit*{\addcomma\space}\usebibmacro{undf:pubdate}[full]}%
  \usebibmacro{undf:electronic}%
  \usebibmacro{finentry}%
}

% ----------------------------------------------------
% Evento monografico e contribuicao publicada em anais
% ----------------------------------------------------
\DeclareFieldFormat[inproceedings]{title}{#1}
\DeclareFieldFormat{undf:eventname}{\MakeUppercase{#1}}
\DeclareFieldFormat{undf:eventnumber}{#1\isdot}
\DeclareFieldFormat{undf:proceedingstitle}{\mkbibemph{#1}}
\newbibmacro*{undf:checkevent}{%
  \iffieldundef{eventtitle}{\undf@missingessential{eventtitle}}{}%
  \iffieldundef{eventyear}{\undf@missingessential{eventdate}}{}%
  \usebibmacro{undf:checkimprint}%
  \ifentrytype{inproceedings}
    {\iffieldundef{booktitle}{\undf@missingessential{booktitle}}{}%
     \iffieldundef{pages}
       {\PackageWarningNoLine{undf-biblatex}{Paginas de evento ausentes: \thefield{entrykey}. Confira a contribuicao; nenhum intervalo sera inventado}}{}}{}%
  \ifboolexpr{not test {\iffieldundef{number}} and test {\iffieldundef{series}}}
    {\PackageWarningNoLine{undf-biblatex}{Numero de evento ambiguo: \thefield{entrykey}. number e da serie; informe a edicao do evento em eventtitleaddon. Valor preservado sem inferencia}}{}%
  \ifboolexpr{not test {\iflistundef{organization}} or not test {\iflistundef{institution}}}
    {\PackageWarningNoLine{undf-biblatex}{Entidade do evento sem papel definido: \thefield{entrykey}. Confira organization/institution; nao presumem autoria ou editora, descreva o papel em nota}}{}%
}
\newbibmacro*{undf:event}{%
  \printfield[undf:eventname]{eventtitle}%
  \setunit*{\addcomma\space}\printfield[undf:eventnumber]{eventtitleaddon}%
  \iffieldundef{eventyear}{}%
    {\setunit{\addcomma\space}\printtext{\mkdaterangeyear{event}}}%
  \setunit*{\addcomma\space}\printfield{venue}%
}
\newbibmacro*{undf:proceedingstitle}[1]{%
  \printfield[undf:proceedingstitle]{#1title}%
  \iffieldundef{#1subtitle}{}%
    {\setunit{\addcolon\space}\printfield{#1subtitle}}%
  \newunit\newblock\printfield{#1titleaddon}%
}
\newbibmacro*{undf:eventpublication}{%
  \newunit\newblock\usebibmacro{undf:editor}%
  \newunit\newblock\usebibmacro{undf:edition}%
  \newunit\newblock\usebibmacro{undf:imprenta}%
  \newunit\newblock\printfield[undf:journalvolume]{volume}\printfield{part}%
  \newunit\newblock\printfield{series}%
  \setunit*{\addcomma\space}\printfield[undf:journalnumber]{number}%
}
\DeclareBibliographyDriver{inproceedings}{%
  \usebibmacro{begentry}\usebibmacro{undf:checkevent}%
  \usebibmacro{undf:mainauthor}\setunit{\adddot\space}\usebibmacro{undf:title}%
  \ifboolexpr{not test {\iffieldundef{eventtitle}} or not test {\iffieldundef{booktitle}}}
    {\newunit\newblock\printtext{In\addcolon\space}\usebibmacro{undf:event}%
     \newunit\newblock\usebibmacro{undf:proceedingstitle}{book}}{}%
  \usebibmacro{undf:eventpublication}%
  \newunit\newblock\printfield[undf:journalpages]{pages}%
  \usebibmacro{undf:electronic}\finentry
}
\DeclareBibliographyDriver{proceedings}{%
  \usebibmacro{begentry}\usebibmacro{undf:checkevent}%
  \usebibmacro{undf:event}\newunit\newblock
  \usebibmacro{undf:proceedingstitle}{}%
  \newunit\newblock\usebibmacro{byauthor}%
  \usebibmacro{undf:eventpublication}%
  \newunit\newblock\printfield{pagetotal}%
  \usebibmacro{undf:electronic}\finentry
}

% Colecao e fasciculo sao objetos distintos, declarados em entrysubtype.
% O modelo nativo periodical representa fasciculos; nao se infere o objeto.
\ExplSyntaxOn
\cs_new_protected:Npn \undf_periodical_title:n #1
  {
    \exp_args:Nne \regex_match:nnTF { [\{\}\\\$\^_] | \x{7E} | [a-z][A-Z] } {\tl_to_str:n {#1}}
      {\PackageWarningNoLine{undf-biblatex}{Titulo~protegido~do~periodico:~\thefield{entrykey}.~Caixa~preservada;~confira~a~apresentacao~editorial}#1}
      {\MakeUppercase{#1}}
  }
\cs_new_eq:NN \undf@periodicaltitle \undf_periodical_title:n
\ExplSyntaxOff
\DeclareFieldFormat{undf:periodicaltitle}{\undf@periodicaltitle{#1}}
\DeclareFieldFormat[periodical]{issn}{ISSN\addspace#1}
\DeclareFieldFormat[periodical]{pagetotal}{#1\addspace p\adddot}
\newbibmacro*{undf:checkperiodical}{%
  \iffieldundef{title}{\undf@missingessential{title}}{}%
  \usebibmacro{undf:checkimprint}%
  \ifboolexpr{test {\iffieldequalstr{entrysubtype}{colecao}} or test {\iffieldequalstr{entrysubtype}{parte-colecao}}}
    {\PackageWarningNoLine{undf-biblatex}{Datas da colecao: \thefield{entrykey}. date identifica a existencia; fim ou continuidade so quando fornecidos. Em parte-colecao, delimite o periodo consultado em note}%
     \ifboolexpr{not test {\iffieldundef{volume}} or not test {\iffieldundef{number}} or not test {\iffieldundef{issuetitle}}}
       {\PackageWarningNoLine{undf-biblatex}{Colecao com dados de fasciculo: \thefield{entrykey}. Confira o objeto; dados preservados sem reclassificacao}}{}}
    {\iffieldequalstr{entrysubtype}{fasciculo}
       {\PackageWarningNoLine{undf-biblatex}{Data do fasciculo: \thefield{entrykey}. Confira date proprio; a data herdada da colecao nao identifica automaticamente o fasciculo}}
       {\PackageWarningNoLine{undf-biblatex}{Objeto periodico nao definido: \thefield{entrykey}. Informe entrysubtype colecao, parte-colecao ou fasciculo; dados preservados sem inferencia}}}%
  \iflistundef{organization}{}%
    {\PackageWarningNoLine{undf-biblatex}{Entidade do periodico: \thefield{entrykey}. organization nao presume autoria ou editora; descreva o papel em nota}}%
  \iffieldundef{pages}{}%
    {\PackageWarningNoLine{undf-biblatex}{Paginacao de periodico integral: \thefield{entrykey}. pages nao e extensao total; confira pagetotal ou nota. Intervalo nao impresso como artigo}}%
  \iffieldundef{journaltitle}{}%
    {\PackageWarningNoLine{undf-biblatex}{Campo de artigo em periodico: \thefield{entrykey}. Informe o titulo do periodico em title; journaltitle nao o substitui}}%
}
\newbibmacro*{undf:periodicalnumber}{%
  \printfield{series}%
  \setunit*{\addcomma\space}\printfield[undf:journalvolume]{volume}%
  \setunit*{\addcomma\space}\printfield[undf:journalnumber]{number}%
}
\DeclareBibliographyDriver{periodical}{%
  \usebibmacro{begentry}\usebibmacro{undf:checkperiodical}%
  \printfield[undf:periodicaltitle]{title}%
  \setunit{\addcolon\space}\printfield{subtitle}%
  \newunit\newblock\printfield{titleaddon}%
  \newunit\newblock\printlist{location}%
  \setunit*{\addcolon\space}\printlist{publisher}%
  \iffieldequalstr{entrysubtype}{fasciculo}
    {\setunit*{\addcomma\space}\usebibmacro{undf:periodicalnumber}%
     \setunit*{\addcomma\space}\usebibmacro{undf:pubdate}[full]}
    {\setunit*{\addcomma\space}\usebibmacro{undf:pubdate}%
     \newunit\newblock\usebibmacro{undf:periodicalnumber}}%
  \newunit\newblock\printfield{issue}%
  \newunit\newblock\printfield[titlecase]{issuetitle}%
  \setunit{\addcolon\space}\printfield[titlecase]{issuesubtitle}%
  \newunit\newblock\usebibmacro{undf:editor}%
  \newunit\newblock\printfield{pagetotal}%
  \newunit\newblock\printfield{issn}%
  \usebibmacro{undf:electronic}\finentry
}


% Patente: inventor, titular e datas com papeis explicitamente cadastrados.
\DeclareFieldFormat[patent]{title}{\ifnameundef{labelname}{#1}{\mkbibemph{#1}}}
\DeclareFieldFormat[patent]{number}{#1}
\DeclareFieldFormat[patent]{type}{\ifbibstring{#1}{\biblstring{#1}}{#1}}
\newbibmacro*{undf:checkpatent}{%
  \ifnameundef{author}{\undf@missingessential{author}}{}%
  \iffieldundef{number}{\undf@missingessential{number}}{}%
  \ifnameundef{holder}
    {\PackageWarningNoLine{undf-biblatex}{Responsabilidade de patente incompleta: \thefield{entrykey}. Confira titular em holder e depositante/procurador em nota, quando pertinentes; nenhum nome sera inferido}}{}%
  \iffieldundef{type}
    {\PackageWarningNoLine{undf-biblatex}{Identificacao de patente: \thefield{entrykey}. Confira em type o papel do numero; numero literal preservado sem presumir concessao}}{}%
  \iflistundef{location}
    {\PackageWarningNoLine{undf-biblatex}{Ambito de patente ausente: \thefield{entrykey}. Confira pais/autoridade; nenhum orgao sera deduzido do numero}}{}%
  \PackageWarningNoLine{undf-biblatex}{Dados de patente a conferir: \thefield{entrykey}. Informe em nota deposito, prioridade, publicacao e concessao somente quando fornecidos, com seus papeis. date/year identifica o documento consultado; nao comprova concessao ou vigencia}%
  \ifboolexpr{not test {\iffieldundef{origyear}} or not test {\iffieldundef{eventyear}}}
    {\PackageWarningNoLine{undf-biblatex}{Data sem papel de patente: \thefield{entrykey}. origdate/eventdate nao identificam prioridade, deposito ou concessao; descreva o papel em nota. Campos nao usados como datas da patente}}{}%
  \ifboolexpr{not test {\iflistundef{institution}} or not test {\iflistundef{organization}}
    or not test {\iflistundef{publisher}} or not test {\ifnameundef{editor}}}
    {\PackageWarningNoLine{undf-biblatex}{Entidade de patente sem papel definido: \thefield{entrykey}. institution/organization/publisher/editor nao presumem inventor, titular ou orgao; confira a fonte e descreva o papel em nota}}{}%
}
\DeclareBibliographyDriver{patent}{%
  \usebibmacro{begentry}\usebibmacro{undf:checkpatent}%
  \usebibmacro{undf:mainauthor}\setunit{\adddot\space}\usebibmacro{undf:title}%
  \newunit\newblock\printfield{titleaddon}%
  \ifnameundef{holder}{}%
    {\newunit\newblock\printtext{Titular\addcolon\space}%
     \printnames[undf:family-given]{holder}}%
  \newunit\newblock\printfield{type}%
  \setunit*{\addspace}\printfield{number}%
  \iflistundef{location}{}%
    {\setunit*{\addspace}\printtext[parens]{\printlist{location}}}%
  \newunit\newblock\printfield{version}%
  \newunit\newblock\printtext{Data do documento consultado\addcolon\space}%
  \usebibmacro{undf:pubdate}[full]%
  \usebibmacro{undf:electronic}\finentry
}

\ProvidesFile{undf-abnt.bbx}[2026/04/11 UnDF bibliography style]

\RequireBibliographyStyle{standard}

% ----------------------------------------------------
% Formatação de campos bibliográficos
% ----------------------------------------------------
% A entrada pelo titulo nao muda os dados nem recebe destaque tipografico.
\ExplSyntaxOn
\clist_const:Nx \c_undf_articles_clist {\tl_to_str:n {a,as,o,os,um,uma,uns,umas}}
\cs_new_protected:Npn \undf_entry_title:n #1
  {
    \seq_set_split:Nnn \l_tmpa_seq { ~ } {#1}
    \seq_pop_left:NN \l_tmpa_seq \l_tmpa_tl
    \tl_set:Nx \l_tmpb_tl {\str_lowercase:f {\tl_to_str:V \l_tmpa_tl}}
    \exp_args:NNV \clist_if_in:NnT \c_undf_articles_clist \l_tmpb_tl
      {\seq_if_empty:NF \l_tmpa_seq
        {\seq_pop_left:NN \l_tmpa_seq \l_tmpb_tl
         \tl_put_right:Nx \l_tmpa_tl { ~ \exp_not:V \l_tmpb_tl}}}
    \exp_args:NV \MakeUppercase \l_tmpa_tl
    \seq_if_empty:NF \l_tmpa_seq { ~ \seq_use:Nn \l_tmpa_seq { ~ }}
  }
\cs_new_eq:NN \undf@entrytitle \undf_entry_title:n
\ExplSyntaxOff
\DeclareFieldFormat{undf:entrytitle}{\undf@entrytitle{#1}}
\DeclareFieldFormat{title}{\ifnameundef{labelname}{#1}{\mkbibemph{#1}}}
\DeclareFieldFormat[article,incollection,inbook]{title}{#1}
\DeclareFieldFormat[article,incollection,inbook]{pages}{#1}
\DeclareFieldFormat[misc]{pages}{#1}
\DeclareFieldFormat[online,misc,report,thesis]{title}{#1}

% ----------------------------------------------------
% Formatação de URL sem espaçamento artificial
% ----------------------------------------------------
\DeclareFieldFormat{url}{%
  \begingroup
    \urlstyle{same}%
    \Urlmuskip=0mu\relax
    \url{#1}%
  \endgroup}

% ----------------------------------------------------
% Bibliografia sem marcador visual
% ----------------------------------------------------
\defbibenvironment{bibliography}
  {\list{}%
     {%
       \setlength{\leftmargin}{0pt}%
       \setlength{\rightmargin}{0pt}%
       \setlength{\labelwidth}{0pt}%
       \setlength{\labelsep}{0pt}%
       \setlength{\itemindent}{0pt}%
       \setlength{\listparindent}{0pt}%
       \setlength{\itemsep}{\baselineskip}%
       \setlength{\parsep}{0pt}%
       \setlength{\topsep}{0pt}%
       \setlength{\partopsep}{0pt}%
       \setlength{\parindent}{0pt}%
       \setlength{\parskip}{0pt}%
     }%
   \singlespacing
   \setlength{\parindent}{0pt}%
   \setlength{\parskip}{0pt}%
   \setlength{\leftskip}{0pt}%
   \setlength{\rightskip}{0pt}%
   \setlength{\parfillskip}{0pt plus 1fil}%
   \hangindent=0pt\relax
   \hangafter=1\relax
   \everypar{}%
   \emergencystretch=3em\relax
   \fussy
  }
  {\endlist}
  {\item\relax}

% ----------------------------------------------------
% Formato institucional de nomes
% ----------------------------------------------------
\DeclareNameAlias{undf:family-given}{family-given}

\newcommand*{\undf@upperbibnames}{%
  \renewcommand*{\mkbibnamefamily}[1]{\MakeUppercase{##1}}%
  \renewcommand*{\mkbibnameprefix}[1]{\MakeUppercase{##1}}%
}

% ----------------------------------------------------
% Macros auxiliares da bibliografia
% ----------------------------------------------------
% Qualificadores sao fornecidos pelo autor (EDTF), nunca inferidos pelo estilo.
\NewBibliographyString{coordinator,coordinators,bycoordinator}
\DefineBibliographyStrings{portuguese}{%
  circa={ca\adddot},
  editors={ed\adddot},
  organizers={org\adddot},
  coordinator={coord\adddot},
  coordinators={coord\adddot},
  bycoordinator={coord\adddotspace por}%
}
\DeclareFieldFormat{date}{%
  \ifboolexpr{test {\ifdatecirca} or test {\ifdateuncertain}
    or test {\iffieldequalstr{labelyear}{nodate}}}
    {\mkbibbrackets{#1}}{#1}%
}
\DeclareFieldAlias{labeldate}{date}

% Monografias/relatorios usam anos; artigo, online, legislacao e defesa preservam precisao.
\newbibmacro*{undf:pubdate}[1][year]{%
  \iffieldundef{year}
    {\printlabeldateextra}
    {\ifstrequal{#1}{year}{\mkdaterangeyearextra{}}{\printdateextra}}%
}
\renewbibmacro*{date}{\usebibmacro{undf:pubdate}[full]}

\newbibmacro*{undf:checkeditorrole}{%
  \iffieldundef{editortype}{}%
    {\ifbibxstring{\thefield{editortype}}{}%
      {\PackageWarningNoLine{undf-biblatex}{Funcao editorial literal: \thefield{entrykey}. Confira editortype; o valor informado sera preservado}}}%
}

\newbibmacro*{undf:editor}{%
  \ifnameundef{editor}{}%
    {{\undf@upperbibnames\printnames[undf:family-given]{editor}}%
     \setunit{\addspace}%
     \usebibmacro{undf:checkeditorrole}%
     \printtext[parens]{\usebibmacro{editorstrg}}}%
}

\newbibmacro*{undf:byeditor}{%
  \ifnameundef{editor}{}%
    {\newunit\newblock
     \usebibmacro{undf:checkeditorrole}%
     \usebibmacro{byeditor}}%
}

\newbibmacro*{undf:secondaryeditor}{%
  \ifnameundef{author}{}{\usebibmacro{undf:byeditor}}%
}

\newbibmacro*{undf:containereditor}{%
  \ifnameundef{bookauthor}{}{\usebibmacro{undf:byeditor}}%
}

\newbibmacro*{undf:mainauthor}{%
  \ifnameundef{author}
    {\ifuseeditor{\usebibmacro{undf:editor}}{}}
    {{\undf@upperbibnames\printnames[undf:family-given]{author}}}%
}

\newbibmacro*{undf:containerauthor}{%
  \ifnameundef{bookauthor}
    {\usebibmacro{undf:editor}}
    {{\undf@upperbibnames\printnames[undf:family-given]{bookauthor}}}%
}

\newbibmacro*{undf:title}{%
  \ifnameundef{labelname}
    {\printfield[undf:entrytitle]{title}}
    {\printfield{title}}%
  \iffieldundef{subtitle}
    {}
    {\iffieldundef{title}{}{\setunit{\addcolon\space}}\printfield{subtitle}}%
}
\letbibmacro{undf:native-title}{title}
\renewbibmacro*{title}{%
  \ifnameundef{labelname}
    {\usebibmacro{undf:title}\newunit\printfield{titleaddon}}
    {\usebibmacro{undf:native-title}}%
}

\newbibmacro*{undf:edition}{%
  \iffieldundef{edition}
    {}
    {\printfield{edition}}%
}

\newbibmacro*{undf:maintitle+title}{%
  % Somente pares inteiros iguais representam uma repeticao do mesmo titulo.
  \ifboolexpr{test {\iffieldsequal{maintitle}{title}} and
    (test {\iffieldsequal{mainsubtitle}{subtitle}} or
      (test {\iffieldundef{mainsubtitle}} and test {\iffieldundef{subtitle}}))}
    {\clearfield{maintitle}\clearfield{mainsubtitle}}{}%
  \ifnameundef{labelname}{\usebibmacro{undf:title}\newunit\newblock}{}%
  \iffieldundef{maintitle}{}%
    {\printtext{\renewcommand*{\subtitlepunct}{\addcolon\space}\usebibmacro{maintitle}}%
     \newunit\newblock
     \iffieldundef{volume}{}%
       {\printfield{volume}\printfield{part}\setunit{\addcolon\space}}}%
  \ifnameundef{labelname}{}{\usebibmacro{undf:title}}%
}

\newbibmacro*{undf:volume}{%
  \iffieldundef{maintitle}
    {\iffieldundef{volume}{}{\printfield{volume}\printfield{part}}}{}%
}

\newbibmacro*{undf:imprenta}[1][publisher]{%
  \iflistundef{location}
    {}
    {%
      \printlist{location}%
      \iflistundef{#1}
        {}
        {\addcolon\space}%
    }%
  \iflistundef{#1}
    {}
    {\printlist{#1}}%
  \ifboolexpr{test {\iflistundef{location}} and test {\iflistundef{#1}}}
    {}{\setunit{\addcomma\space}}%
  \usebibmacro{undf:pubdate}%
}

\DeclareFieldFormat{undf:journalvolume}{v\adddot\space#1}
\DeclareFieldFormat{undf:journalnumber}{n\adddot\space#1}
\DeclareFieldFormat{undf:journalpages}{p\adddot\space#1}
\newbibmacro*{undf:journalinfo}{%
  \printfield{journaltitle}%
  \iffieldundef{journalsubtitle}{}%
    {\iffieldundef{journaltitle}{}{\setunit{\addcolon\space}}%
     \printfield{journalsubtitle}}%
  \setunit*{\addcomma\space}\printlist{location}%
  \setunit*{\addcomma\space}\printfield[undf:journalvolume]{volume}%
  \setunit*{\addcomma\space}\printfield[undf:journalnumber]{number}%
  \setunit*{\addcomma\space}\printfield[undf:journalpages]{pages}%
  \setunit*{\addcomma\space}%
  \usebibmacro{undf:pubdate}[full]%
}

% Diagnosticos de revisao, sem completar dados nem impedir a compilacao.
\newcommand*{\undf@missingessential}[1]{%
  \PackageWarningNoLine{undf-biblatex}{Essencial ausente: \thefield{entrykey} (#1). Confira a fonte; nenhum valor sera inferido}}
\newbibmacro*{undf:checkimprint}{%
  \iflistundef{publisher}{\undf@missingessential{publisher}}{}%
  \iflistundef{location}{\undf@missingessential{location}}{}%
}
\newbibmacro*{undf:checkessential}{%
  \iffieldundef{title}{\undf@missingessential{title}}{}%
  \ifentrytype{article}
    {\iffieldundef{journaltitle}{\undf@missingessential{journaltitle}}{}%
     \iflistundef{location}{\undf@missingessential{location}}{}}{}%
  \ifboolexpr{test {\ifentrytype{book}} or test {\ifentrytype{mvbook}}
    or test {\ifentrytype{collection}} or test {\ifentrytype{mvcollection}}
    or test {\ifentrytype{reference}} or test {\ifentrytype{mvreference}}}
    {\usebibmacro{undf:checkimprint}}{}%
  \ifboolexpr{test {\ifentrytype{inbook}} or test {\ifentrytype{incollection}}
    or test {\ifentrytype{bookinbook}} or test {\ifentrytype{inreference}}
    or test {\ifentrytype{suppbook}} or test {\ifentrytype{suppcollection}}}
    {\iffieldundef{booktitle}{\undf@missingessential{booktitle}}{}%
     \usebibmacro{undf:checkimprint}%
     \ifboolexpr{test {\iffieldundef{pages}} and test {\iffieldundef{volume}}}
       {\undf@missingessential{pages/volume}}{}}{}%
  \ifboolexpr{test {\ifentrytype{thesis}} or test {\ifentrytype{mastersthesis}}
    or test {\ifentrytype{phdthesis}}}
    {\iffieldundef{type}{\undf@missingessential{type}}{}%
     \iflistundef{institution}{\undf@missingessential{institution}}{}%
     \iflistundef{location}{\undf@missingessential{location}}{}}{}%
  \ifboolexpr{(test {\ifentrytype{report}} or test {\ifentrytype{techreport}})
    and test {\iflistundef{publisher}} and test {\iflistundef{institution}}}
    {\undf@missingessential{publisher/institution}}{}%
}
\letbibmacro{undf:native-begentry}{begentry}
\renewbibmacro*{begentry}{%
  \usebibmacro{undf:native-begentry}\usebibmacro{undf:checkessential}}

\newbibmacro*{undf:urlaccess}{%
  \iffieldundef{url}
    {\ifentrytype{online}
      {\PackageWarningNoLine{undf-biblatex}{URL ausente: \thefield{entrykey}. Informe o endereco consultado quando disponivel}}{}}%
    {%
      \adddot\par
      % O grupo de cada entrada limita o alinhamento a este bloco final.
      \raggedright\noindent Disponível em:\space\printfield{url}%
      \iffieldundef{urlyear}
        {\PackageWarningNoLine{undf-biblatex}{Acesso ausente: \thefield{entrykey}. Informe a data real de consulta}}
        {\adddot}%
    }%
  \iffieldundef{urlyear}
    {}
    {%
      \iffieldundef{url}
        {\PackageWarningNoLine{undf-biblatex}{Acesso sem URL: \thefield{entrykey}. Confira o endereco associado a data informada}}{}%
      \ifboolexpr{test {\iffieldundef{urlmonth}} or test {\iffieldundef{urlday}}}
        {\PackageWarningNoLine{undf-biblatex}{Acesso parcial: \thefield{entrykey}. Confira dia, mes e ano sem completar dados por suposicao}}{}%
      \par\noindent Acesso em:\space
      {\DeclareFieldFormat{urldate}{##1}\mkdaterangelong{url}}%
    }%
}

% Somente igualdade literal com um resolvedor conhecido permite unir DOI e URL.
% Consultas, fragmentos e outros enderecos permanecem distintos; nao ha rede.
\ExplSyntaxOn
\cs_new_protected:Npn \undf@ifdoiurlTF #1#2
  {
    \str_if_eq:eeTF {\thefield{url}} {https://doi.org/\thefield{doi}} {#1}
      {\str_if_eq:eeTF {\thefield{url}} {http://doi.org/\thefield{doi}} {#1}
        {\str_if_eq:eeTF {\thefield{url}} {https://dx.doi.org/\thefield{doi}} {#1}
          {\str_if_eq:eeTF {\thefield{url}} {http://dx.doi.org/\thefield{doi}} {#1} {#2}}}}
  }
\ExplSyntaxOff

% Bloco compartilhado com os drivers herdados, preservando formatos e opcoes nativos.
\renewbibmacro*{doi+eprint+url}{%
  \iftoggle{bbx:doi}
    {\iftoggle{bbx:url}
      {\undf@ifdoiurlTF{}{\printfield{doi}}}
      {\printfield{doi}}}{}%
  \newunit\newblock
  \iftoggle{bbx:eprint}{\usebibmacro{eprint}}{}%
  \newunit\newblock
  \iftoggle{bbx:url}{\usebibmacro{undf:urlaccess}}{}%
}

% Igualdade literal com informacao ja impressa nao acrescenta outra nota.
% type identifica a natureza somente nos drivers de relatorio/trabalho academico.
\newcommand*{\undf@clearduplicatematerial}[1]{%
  \ifboolexpr{test {\iffieldsequal{#1}{title}}
    or test {\iffieldsequal{#1}{subtitle}}
    or test {\iffieldsequal{#1}{howpublished}}
    or ((test {\ifentrytype{report}} or test {\ifentrytype{techreport}}
      or test {\ifentrytype{thesis}} or test {\ifentrytype{mastersthesis}}
      or test {\ifentrytype{phdthesis}})
      and test {\iffieldsequal{#1}{type}})}
    {\clearfield{#1}}{}%
}
\newbibmacro*{undf:materialnotes}{%
  \begingroup
  \forcsvlist{\undf@clearduplicatematerial}{note,addendum,pubstate}%
  \iffieldsequal{addendum}{note}{\clearfield{addendum}}{}%
  \iffieldsequal{pubstate}{note}{\clearfield{pubstate}}{}%
  \iffieldsequal{pubstate}{addendum}{\clearfield{pubstate}}{}%
  \printfield{note}%
  \newunit\newblock
  \usebibmacro{addendum+pubstate}%
  \endgroup
}

\newbibmacro*{undf:electronic}{%
  \newunit\newblock
  \printfield{howpublished}%
  \newunit\newblock
  \usebibmacro{undf:materialnotes}%
  \newunit\newblock
  \usebibmacro{doi+eprint+url}%
}

\newbibmacro*{undf:legisource}{%
  \printfield{journaltitle}%
  \iflistundef{location}
    {}
    {\addcomma\space\printlist{location}}%
  \setunit{\addcomma\space}%
  \usebibmacro{undf:pubdate}[full]%
  \iffieldundef{pages}
    {}
    {\addcomma\space p\adddot\space\printfield{pages}}%
}

% ----------------------------------------------------
% Drivers bibliográficos
% ----------------------------------------------------
\DeclareBibliographyDriver{book}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:maintitle+title}%
  \usebibmacro{undf:secondaryeditor}%
  \newunit\newblock
  \usebibmacro{undf:edition}%
  \newunit\newblock
  \usebibmacro{undf:volume}%
  \newunit\newblock
  \usebibmacro{undf:imprenta}%
  \usebibmacro{undf:electronic}%
  \finentry
}

\DeclareBibliographyDriver{mvbook}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:maintitle+title}%
  \usebibmacro{undf:secondaryeditor}%
  \newunit\newblock
  \usebibmacro{undf:edition}%
  \newunit\newblock
  \usebibmacro{undf:volume}%
  \newunit\newblock
  \usebibmacro{undf:imprenta}%
  \usebibmacro{undf:electronic}%
  \finentry
}

\DeclareBibliographyDriver{collection}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:maintitle+title}%
  \usebibmacro{undf:secondaryeditor}%
  \newunit\newblock
  \usebibmacro{undf:edition}%
  \newunit\newblock
  \usebibmacro{undf:volume}%
  \newunit\newblock
  \usebibmacro{undf:imprenta}%
  \usebibmacro{undf:electronic}%
  \finentry
}

\DeclareBibliographyDriver{mvcollection}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:maintitle+title}%
  \usebibmacro{undf:secondaryeditor}%
  \newunit\newblock
  \usebibmacro{undf:edition}%
  \newunit\newblock
  \usebibmacro{undf:volume}%
  \newunit\newblock
  \usebibmacro{undf:imprenta}%
  \usebibmacro{undf:electronic}%
  \finentry
}

\DeclareBibliographyDriver{article}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \newunit\newblock
  \usebibmacro{undf:journalinfo}%
  \usebibmacro{undf:electronic}%
  \finentry
}

\DeclareBibliographyDriver{incollection}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \setunit{\adddot\space}%
  \printtext{In\addcolon\space}%
  \usebibmacro{undf:containerauthor}%
  \setunit{\adddot\space}%
  \printtext{\renewcommand*{\subtitlepunct}{\addcolon\space}\usebibmacro{maintitle+booktitle}}%
  \usebibmacro{undf:containereditor}%
  \newunit\newblock
  \usebibmacro{undf:edition}%
  \newunit\newblock
  \usebibmacro{undf:volume}%
  \newunit\newblock
  \usebibmacro{undf:imprenta}%
  \iffieldundef{pages}
    {}
    {\addcomma\space p\adddot\space\printfield{pages}}%
  \usebibmacro{undf:electronic}%
  \finentry
}

\DeclareBibliographyDriver{inbook}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \setunit{\adddot\space}%
  \printtext{In\addcolon\space}%
  \usebibmacro{undf:containerauthor}%
  \setunit{\adddot\space}%
  \printtext{\renewcommand*{\subtitlepunct}{\addcolon\space}\usebibmacro{maintitle+booktitle}}%
  \usebibmacro{undf:containereditor}%
  \newunit\newblock
  \usebibmacro{undf:edition}%
  \newunit\newblock
  \usebibmacro{undf:volume}%
  \newunit\newblock
  \usebibmacro{undf:imprenta}%
  \iffieldundef{pages}
    {}
    {\addcomma\space p\adddot\space\printfield{pages}}%
  \usebibmacro{undf:electronic}%
  \finentry
}

% ----------------------------------------------------
% Documentos online
% ----------------------------------------------------
\DeclareBibliographyDriver{online}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \newunit\newblock
  \iflistundef{location}
    {}
    {\printlist{location}}%
  \iflistundef{publisher}
    {}
    {%
      \iflistundef{location}
        {}
        {\addcolon\space}%
      \printlist{publisher}%
    }%
  \ifboolexpr{test {\iflistundef{location}} and test {\iflistundef{publisher}}}
    {}{\setunit{\addcomma\space}}%
  \usebibmacro{undf:pubdate}[full]%
  \usebibmacro{undf:electronic}%
  \finentry
}

% ----------------------------------------------------
% Trabalhos acadêmicos
% ----------------------------------------------------
\DeclareBibliographyDriver{thesis}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \newunit\newblock
  \printfield{type}%
  \setunit*{\addcomma\space}\printlist{institution}%
  \setunit*{\addcomma\space}\printlist{location}%
  \setunit*{\addcomma\space}%
  \usebibmacro{undf:pubdate}[full]%
  \usebibmacro{undf:electronic}%
  \finentry
}

% ----------------------------------------------------
% Relatórios e documentos institucionais
% ----------------------------------------------------
\DeclareBibliographyDriver{report}{%
  \usebibmacro{begentry}%
  \usebibmacro{undf:mainauthor}%
  \setunit{\adddot\space}%
  \usebibmacro{undf:title}%
  \iffieldundef{type}
    {}
    {\adddot\space\printfield{type}}%
  \iffieldundef{number}
    {}
    {\addcomma\space n\adddot\space\printfield{number}}%
  \newunit\newblock
  % Instituicao responsavel nao e promovida a autora. Listas identicas
  % de instituicao/editora aparecem uma vez no bloco de publicacao.
  \iflistundef{publisher}
    {\usebibmacro{undf:imprenta}[institution]}
    {%
      \iflistundef{institution}
        {}
        {\iflistsequal{institution}{publisher}
          {}
          {\printlist{institution}\newunit\newblock}}%
      \usebibmacro{undf:imprenta}%
    }%
  \usebibmacro{undf:electronic}%
  \finentry
}

% ----------------------------------------------------
% Documento jurídico - legislação
% ----------------------------------------------------
\DeclareBibliographyDriver{legislation}{%
  \usebibmacro{begentry}%
  \printnames{author}%
  \setunit{\adddot\space}%
  \printfield[titlecase]{title}%
  \iffieldundef{subtitle}
    {}
    {\setunit{\addcolon\space}\printfield[titlecase]{subtitle}}%
  \setunit{\adddot\space}%
  \printfield{journaltitle}%
  \iflistundef{location}
    {}
    {\setunit{\addcomma\space}\printlist{location}}%
  \setunit{\addcomma\space}%
  \usebibmacro{undf:pubdate}[full]%
  \iffieldundef{pages}
    {}
    {\setunit{\addcomma\space}\printfield{pages}}%
  \usebibmacro{undf:electronic}%
  \usebibmacro{finentry}%
}

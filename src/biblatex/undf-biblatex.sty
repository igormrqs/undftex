\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{src/biblatex/undf-biblatex}[2026/01/01 UnDF-TeX biblatex layer]

\RequirePackage{xparse}
\RequirePackage{etoolbox}
\RequirePackage{csquotes}
\RequirePackage{setspace}
\RequirePackage{needspace}

\RequirePackage[
  backend=biber,
  style=undf-abnt,
  citestyle=undf-abnt,
  sorting=nyt,
  maxcitenames=3,
  mincitenames=1,
  maxbibnames=99,
  giveninits=false,
  uniquelist=false,
  uniquename=minyearfull,
  datecirca=true,
  dateuncertain=true
]{biblatex}

% xurl configura as penalidades de quebra somente se BibLaTeX ja estiver carregado.
\RequirePackage{xurl}
\urlstyle{same}

% O editor da obra recipiente nao identifica a parte sem autoria.
% A opcao tambem orienta os rotulos e a ordenacao calculados pelo Biber.
\ExecuteBibliographyOptions[inbook,bookinbook,suppbook,incollection,inreference,suppcollection,inproceedings,conference]{useeditor=false}

% O DOI do recipiente nao identifica automaticamente sua parte.
% Campos DOI informados na propria parte (inclusive via xdata) sao preservados.
\DeclareDataInheritance{book,mvbook,collection,mvcollection,reference,mvreference}
  {inbook,bookinbook,suppbook,incollection,inreference,suppcollection}{%
  \noinherit{doi}%
}

% Anais entram pelo evento, nao pelo organizador ou autor pessoal cadastrado.
\ExecuteBibliographyOptions[proceedings,mvproceedings]{useauthor=false,useeditor=false}
% O periodico entra pelo titulo; a editoria permanece credito secundario.
\ExecuteBibliographyOptions[periodical]{useauthor=false,useeditor=false}
% Titular ou editor nao substitui o inventor de uma patente.
\ExecuteBibliographyOptions[patent]{useeditor=false}
\DeclareDataInheritance{periodical}{article,suppperiodical,periodical}{\noinherit{doi}}
\DeclareLabeltitle[proceedings,mvproceedings]{\field{shorttitle}\field{eventtitle}\field{title}}
% A autoria e o DOI do recipiente nao identificam a contribuicao; xdata e local prevalecem.
\DeclareDataInheritance{proceedings,mvproceedings}{inproceedings,conference}{%
  \noinherit{author}\noinherit{doi}%
}
% Chave de entrada pelo evento; sorttitle/sortkey explicitos continuam prioritarios.
\DeclareSourcemap{\maps[datatype=bibtex]{\map{
  \pertype{proceedings}\pertype{mvproceedings}
  \step[notfield=sorttitle,final]\step[notfield=sortkey,final]
  \step[fieldsource=eventtitle,final]\step[fieldset=sorttitle,origfieldval]
}}}

% Inteiros ASCII simples de ate nove digitos: chave auxiliar, sem alterar title.
% TeX, codigos, decimais e heranca exigem sorttitle editorial.
% Padding somente na chave: largura dez, sem modificar nomes, anos ou rotulos.
\DeclareSourcemap{\maps[datatype=bibtex]{\map[overwrite]{
  \pernottype{xdata}
  \step[notfield=sorttitle,final]
  \step[notfield=sortkey,final]
  \step[notfield=xdata,final]
  \step[notfield=crossref,final]
  \step[notfield=xref,final]
  \step[fieldsource=title,match=\regexp{[0-9]},final]
  \step[fieldsource=title,notmatch=\regexp{[\\{}$^_~]|[0-9]{10}|[0-9][.,][0-9]|[\p{L}_][0-9]|[0-9][\p{L}_]|[-+][0-9]},final]
  \step[fieldset=sorttitle,origfieldval]
  \step[fieldsource=sorttitle,match=\regexp{([0-9]+)},replace={000000000$1}]
  \step[fieldsource=sorttitle,match=\regexp{0+([0-9]{10})(?![0-9])},replace={$1}]
  % Valores iguais conservam desempate pela grafia completa, sem fundir obras.
  \step[fieldsource=title]
  \step[fieldset=sorttitle,origfieldval,append]
}}}

% Deriva somente o rotulo: title e a ordenacao pelo titulo completo permanecem.
% TeX complexo e monossilabos exigem shorttitle conferido no cadastro.
\DeclareSourcemap{\maps[datatype=bibtex]{\map{
  \pernottype{proceedings}\pernottype{mvproceedings}
  \step[notfield=author,final]
  \step[notfield=shorttitle,final]
  \step[fieldsource=langid,match=\regexp{\Aenglish\z},final]
  \step[fieldsource=title,notmatch=\regexp{[\\{}$^_~]},final]
  \step[fieldsource=title,match=\regexp{(?i)\A((?:(?:the|a|an)\s+)?\S+)(?:\s+.*)?\z},final]
  \step[fieldset=shorttitle,fieldvalue={$1}]
}\map{
  \pernottype{proceedings}\pernottype{mvproceedings}
  \step[notfield=author,final]
  \step[notfield=shorttitle,final]
  \step[fieldsource=langid,notmatch=\regexp{\A(?:english|portuguese)\z},final]
  \step[fieldsource=title,final]
  \step[fieldset=shorttitle,origfieldval]
}\map{
  \pernottype{proceedings}\pernottype{mvproceedings}
  \step[notfield=author,final]
  \step[notfield=editor,final]
  \step[notfield=shorttitle,final]
  \step[fieldsource=title,notmatch=\regexp{[\\{}$^_~]},final]
  \step[fieldsource=title,notmatch=\regexp{(?i)\A(?:the|an)\s},final]
  \step[fieldsource=title,match=\regexp{(?i)\A((?:(?:a|as|o|os|um|uma|uns|umas)\s+)?\S+)(?:\s+.*)?\z},final]
  \step[fieldset=shorttitle,fieldvalue={$1}]
}\map{
  % Nas partes, o editor pertence ao recipiente e nao impede o rotulo por titulo.
  \pertype{inbook}\pertype{bookinbook}\pertype{suppbook}
  \pertype{incollection}\pertype{inreference}\pertype{suppcollection}\pertype{inproceedings}\pertype{conference}\pertype{periodical}\pertype{patent}
  \pernottype{proceedings}\pernottype{mvproceedings}
  \step[notfield=author,final]
  \step[notfield=shorttitle,final]
  \step[fieldsource=title,notmatch=\regexp{[\\{}$^_~]},final]
  \step[fieldsource=title,notmatch=\regexp{(?i)\A(?:the|an)\s},final]
  \step[fieldsource=title,match=\regexp{(?i)\A((?:(?:a|as|o|os|um|uma|uns|umas)\s+)?\S+)(?:\s+.*)?\z},final]
  \step[fieldset=shorttitle,fieldvalue={$1}]
}}}
% Data de acesso e data da obra original nao substituem a publicacao da edicao citada.
\DeclareLabeldate{\field{date}\field{year}\literal{nodate}}
\AtDataInput{%
  % O Biber ja forneceu a fonte; o alias labelname ainda nao foi instalado.
  \ifboolexpr{test {\iffieldundef{labelnamesource}}
    and not test {\iffieldundef{langid}}
    and not test {\iffieldequalstr{langid}{english}}
    and not test {\iffieldequalstr{langid}{portuguese}}}
    {\PackageWarningNoLine{undf-biblatex}{Idioma sem abreviacao automatica: \thefield{entrykey}. Titulo completo preservado; confira shorttitle}}{}%
  \ifboolexpr{test {\iffieldundef{labelnamesource}}
    and not test {\ifentrytype{proceedings}}
    and not test {\ifentrytype{mvproceedings}}
    and not test {\ifentrytype{periodical}}}
    {\PackageWarningNoLine{undf-biblatex}{Rotulo por titulo: \thefield{entrykey}. Confira shorttitle, especialmente monossilabos iniciais e comandos TeX}%
     \iflistundef{organization}{}%
       {\PackageWarningNoLine{undf-biblatex}{Organizacao sem autoria definida: \thefield{entrykey}. organization nao presume autoria; confira author na fonte}}}%
    {}%
  \ifboolexpr{test {\ifnameundef{author}} and not test {\ifnameundef{shortauthor}}}
    {\PackageWarningNoLine{undf-biblatex}{Autoria abreviada sem autor: \thefield{entrykey}. shortauthor nao comprova autoria; confira author na fonte sem inventar responsavel}}{}%
  \iffieldundef{year}
    {\PackageWarningNoLine{undf-biblatex}{Data de publicacao ausente: \thefield{entrykey}. Informe ano identificado ou inferido a partir da fonte; a data de acesso nao o substitui}}%
    {}%
}


% ----------------------------------------------------
% Título institucional da bibliografia
% ----------------------------------------------------
\defbibheading{undfreferences}[\refname]{%
  \posttextual
  \undf@specialheadingwithtoc{chapter}{REFERÊNCIAS}%
}

\newcommand{\printundfreferences}{%
  \printbibliography[heading=undfreferences,check=undfconsultadas]
}

% A consulta de dados da original nos comandos apud não equivale à sua leitura.
% O estado é separado por refsection e por chave; citações independentes a preservam.
\newif\ifundf@apudoriginal
\AtEveryCitekey{%
  % Limpa somente o alias local dos objetos cuja identidade nao vem de nomes.
  \ifboolexpr{test {\ifentrytype{proceedings}} or test {\ifentrytype{mvproceedings}} or test {\ifentrytype{periodical}}}
    {\clearname{labelname}}{}%
  \ifundf@apudoriginal
    \csgdef{undf@apudoriginal@\therefsection:\thefield{entrykey}}{}%
  \else
    \csgdef{undf@consultada@\therefsection:\thefield{entrykey}}{}%
  \fi
}
\defbibcheck{undfconsultadas}{%
  \ifcsdef{undf@apudoriginal@\therefsection:\thefield{entrykey}}
    {\ifcsundef{undf@consultada@\therefsection:\thefield{entrykey}}{\skipentry}{}}%
    {}%
}

% ----------------------------------------------------
% Aspas duplas para citação direta curta
% ----------------------------------------------------
\newcommand{\undfdoublequotes}[1]{``#1''}

% ----------------------------------------------------
% Utilitário interno
% ----------------------------------------------------
\newcommand{\undf@ifblankbibTF}[3]{%
  \ifstrempty{#1}{#2}{#3}%
}

\newcommand{\undf@needcitationblockspace}{%
  \Needspace{4\baselineskip}%
}

% ----------------------------------------------------
% Citações principais
% ----------------------------------------------------
\NewDocumentCommand{\citeind}{O{}m}{%
  \undf@ifblankbibTF{#1}
    {\parencite{#2}}
    {\parencite[#1]{#2}}%
}

\NewDocumentCommand{\citeindonline}{O{}m}{%
  \undf@ifblankbibTF{#1}
    {\textcite{#2}}
    {\textcite[#1]{#2}}%
}

\NewDocumentCommand{\citarparenteses}{O{}m}{%
  \citeind[#1]{#2}%
}

\NewDocumentCommand{\citartexto}{O{}m}{%
  \citeindonline[#1]{#2}%
}

\NewDocumentCommand{\citedir}{O{}m m}{%
  \undfdoublequotes{#3}%
  \undf@ifblankbibTF{#1}
    {\space\parencite{#2}}
    {\space\parencite[#1]{#2}}%
}

\NewDocumentCommand{\citedironline}{O{}m m}{%
  \undf@ifblankbibTF{#1}
    {\textcite{#2}}
    {\textcite[#1]{#2}}%
  \space\undfdoublequotes{#3}%
}

\NewDocumentCommand{\citardireta}{O{}m m}{%
  \citedir[#1]{#2}{#3}%
}

\NewDocumentCommand{\citardiretatexto}{O{}m m}{%
  \citedironline[#1]{#2}{#3}%
}

\NewDocumentEnvironment{citacaolonga}{O{}m +b}
{%
  \undf@needcitationblockspace
  \begin{list}{}{%
    \setlength{\leftmargin}{4cm}%
    \setlength{\rightmargin}{0pt}%
    \setlength{\listparindent}{0pt}%
    \setlength{\itemindent}{0pt}%
    \setlength{\parsep}{0pt}%
    \setlength{\topsep}{0pt}%
    \setlength{\partopsep}{0pt}%
  }%
  \item\small\singlespacing
  #3\par
  \nobreak
  \undf@ifblankbibTF{#1}
    {\parencite{#2}}
    {\parencite[#1]{#2}}%
  \end{list}%
}
{}

% ----------------------------------------------------
% Citação de citação (apud) com chaves .bib
% ----------------------------------------------------
\NewDocumentCommand{\apudbib}{O{} O{} m m}{%
  (%
  \begingroup\undf@apudoriginaltrue
  \ifstrempty{#1}
    {\undf@citeidentity{#3}, \undf@citelabeldate{#3}}
    {\undf@citeidentity{#3}, \undf@citelabeldate{#3}, #1}%
  \endgroup
  \space apud\space
  \ifstrempty{#2}
    {\undf@citeidentity{#4}, \undf@citelabeldate{#4}}
    {\undf@citeidentity{#4}, \undf@citelabeldate{#4}, #2}%
  )%
}

\NewDocumentCommand{\apudbibonline}{O{} O{} m m}{%
  \begingroup\undf@apudoriginaltrue
  \undf@citeidentity{#3} (%
  \ifstrempty{#1}
    {\undf@citelabeldate{#3}}
    {\undf@citelabeldate{#3}, #1}%
  \endgroup
  \space apud\space
  \ifstrempty{#2}
    {\undf@citeidentity{#4}, \undf@citelabeldate{#4}}
    {\undf@citeidentity{#4}, \undf@citelabeldate{#4}, #2}%
  )%
}

% ----------------------------------------------------
% Referência completa pontual
% ----------------------------------------------------
\NewDocumentCommand{\fullref}{m}{%
  \fullcite{#1}%
}

\ProvidesFile{undf-abnt.cbx}[2026/04/11 UnDF citation style]

\RequireCitationStyle{authoryear}

% Homonimos no mesmo ano: sobrenome, iniciais; prenome se iniciais nao bastam.
% O nivel e calculado pelo Biber; nomes nao ambiguos conservam apenas sobrenome.
\DeclareNameFormat{labelname}{%
  \ifcase\value{uniquename}%
    \usebibmacro{name:family}
      {\namepartfamily}{\namepartgiven}{\namepartprefix}{\namepartsuffix}%
  \or
    \ifuseprefix
      {\usebibmacro{name:family-given}
        {\namepartfamily}{\namepartgiveni}{\namepartprefix}{\namepartsuffixi}}
      {\let\namepartprefix\empty
       \usebibmacro{name:family-given}
        {\namepartfamily}{\namepartgiveni}{\namepartprefix}{\namepartsuffixi}}%
  \or
    \ifuseprefix
      {\usebibmacro{name:family-given}
        {\namepartfamily}{\namepartgiven}{\namepartprefix}{\namepartsuffix}}
      {\let\namepartprefix\empty
       \usebibmacro{name:family-given}
        {\namepartfamily}{\namepartgiven}{\namepartprefix}{\namepartsuffix}}%
  \fi
  \usebibmacro{name:andothers}%
}

% ----------------------------------------------------
% Delimitadores do sistema autor-data
% ----------------------------------------------------
\renewcommand*{\nameyeardelim}{\addcomma\space}
\DeclareDelimFormat{multinamedelim}{\addsemicolon\space}
\DeclareDelimFormat{finalnamedelim}{\addsemicolon\space}
\DeclareDelimFormat{nonameyeardelim}{\addcomma\space}
\DeclareDelimFormat[textcite]{nonameyeardelim}{\addspace}
\DeclareFieldFormat{undf:citetitle}{%
  #1\iffieldsequal{labeltitle}{title}{}{\addspace\mkbibbrackets{\textellipsis}}}
\renewbibmacro*{cite:label}{%
  \iffieldundef{label}
    {\iffieldundef{labeltitle}{}%
      {\printtext[bibhyperref]{\printfield[undf:citetitle]{labeltitle}}}}
    {\printtext[bibhyperref]{\printfield{label}}}}

% ----------------------------------------------------
% Citação de citação (apud)
% A fonte original aparece no texto.
% A fonte consultada é citada via biblatex e entra nas referências.
% ----------------------------------------------------
% Mesmo rotulo de data das citacoes autor-data, inclusive intervalo e extradate.
% Identidade sem hiperlink: a original do apud pode estar fora da bibliografia.
\DeclareCiteCommand{\undf@citeidentity}
  {\boolfalse{citetracker}\boolfalse{pagetracker}\usebibmacro{prenote}}
  {\ifnameundef{labelname}
     {\iffieldundef{label}
       {\printfield[undf:citetitle]{labeltitle}}
       {\printfield{label}}}
     {\ifciteindex{\indexnames{labelname}}{}\printnames{labelname}}}
  {\multicitedelim}
  {\usebibmacro{postnote}}
% Nao usa \cite*: shorthand pode substituir a chamada inteira, mas nao o ano aqui.
\DeclareCiteCommand{\undf@citelabeldate}
  {\boolfalse{citetracker}%
   \boolfalse{pagetracker}%
   \usebibmacro{prenote}}
  {\printlabeldateextra}
  {\multicitedelim}
  {\usebibmacro{postnote}}

\NewDocumentCommand{\textapud}{ m m O{} m O{} }{%
  #1\space(#2%
  \ifstrempty{#3}{}{,\space p.\space #3}%
  \space apud\space \undf@citeidentity{#4},\space \undf@citelabeldate{#4}%
  \ifstrempty{#5}{}{,\space p.\space #5}%
  )%
}

\NewDocumentCommand{\parenciteapud}{ m m O{} m O{} }{%
  (#1,\space #2%
  \ifstrempty{#3}{}{,\space p.\space #3}%
  \space apud\space \undf@citeidentity{#4},\space \undf@citelabeldate{#4}%
  \ifstrempty{#5}{}{,\space p.\space #5}%
  )%
}

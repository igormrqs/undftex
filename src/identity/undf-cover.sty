\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{src/identity/undf-cover}[2026/04/13 UnDF-TeX cover]

\RequirePackage{graphicx}
\RequirePackage{etoolbox}
\RequirePackage{textcase}

\makeatletter

% ----------------------------------------------------
% Bloco institucional da capa
% A altura do bloco permanece fixa.
% Assim, a logo pode crescer até o limite previsto
% sem empurrar os demais elementos da capa.
% ----------------------------------------------------
\newcommand*{\undf@coveridentity}{%
  \begin{minipage}[c][\undf@coveridentityheight][c]{\textwidth}
    \centering
    \includegraphics[
      width=\undf@logocapawidth,
      height=\undf@logocapaheight,
      keepaspectratio
    ]{\undf@logocapa}\par
  \end{minipage}%
}

% ----------------------------------------------------
% Capa institucional
% ----------------------------------------------------
\newcommand{\undfcover}{%
  \begingroup
    \renewcommand{\thepage}{capa-\arabic{page}}%
    \begin{titlepage}
      \centering

      \undf@coveridentity

      \vfill

      {\bfseries\undfprintautores\par}

      \vfill

      {\bfseries\MakeTextUppercase{\undf@fulltitle}\par}

      \vfill

      \undf@local\par
      \undf@ano\par
    \end{titlepage}
  \endgroup

  \setcounter{page}{0}%
}

\makeatother

% ----------------------------------------------------
% Identidade visual da capa
% ----------------------------------------------------
\def\undf@logocapa{identidade/logo_vertical.png}
\def\undf@logocapawidth{0.66\textwidth}
\def\undf@logocapaheight{5.2cm}
\def\undf@coveridentityheight{5.8cm}
\def\undf@instituicaocapa{Universidade do Distrito Federal}
\def\undf@subinstituicaocapa{Professor Jorge Amaury Maia Nunes -- UnDF}

% ----------------------------------------------------
% Comandos públicos
% ----------------------------------------------------
\newcommand{\logocapa}[1]{\gdef\undf@logocapa{#1}}
\newcommand{\larguralogocapa}[1]{\gdef\undf@logocapawidth{#1}}
\newcommand{\alturalogocapa}[1]{\gdef\undf@logocapaheight{#1}}
\newcommand{\alturablocoinstitucionalcapa}[1]{\gdef\undf@coveridentityheight{#1}}
\newcommand{\instituicaocapa}[1]{\gdef\undf@instituicaocapa{#1}}
\newcommand{\subinstituicaocapa}[1]{\gdef\undf@subinstituicaocapa{#1}}

\makeatother

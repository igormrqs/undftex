\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{manual-style}[2026/08/07 Manual de TCC UnDF]

\RequirePackage{fontspec}
\RequirePackage[brazilian]{babel}
\RequirePackage[a4paper,top=3cm,left=3cm,right=2cm,bottom=2cm]{geometry}
\RequirePackage{setspace}
\RequirePackage{indentfirst}
\RequirePackage{microtype}
\RequirePackage{titlesec}
\RequirePackage{tocloft}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{caption}
\RequirePackage{hyperref}
\RequirePackage{bookmark}
\RequirePackage{xurl}

\setmainfont{Latin Modern Roman}
\setsansfont{Latin Modern Sans}
\setmonofont{Latin Modern Mono}

\onehalfspacing
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{0pt}
\setcounter{secnumdepth}{4}
\setcounter{tocdepth}{3}

\definecolor{undfBlue}{HTML}{1D4D7A}
\definecolor{undfGreen}{HTML}{26735C}
\definecolor{undfGray}{HTML}{F3F5F7}
\definecolor{undfRule}{HTML}{D7DCE2}

\hypersetup{
  colorlinks=true,
  linkcolor=undfBlue,
  citecolor=undfBlue,
  urlcolor=undfBlue,
  pdftitle={Manual de Trabalhos de Conclusão de Curso da UnDF},
  pdfauthor={Universidade do Distrito Federal Professor Jorge Amaury Maia Nunes},
  pdfsubject={Orientações acadêmicas, metodológicas e normativas para elaboração de TCC},
  pdfkeywords={UnDF, TCC, trabalhos acadêmicos, ABNT, versão 0.3.1-preliminar}
}

\DeclareRobustCommand{\marcaUnDF}{\NoCaseChange{UnDF}}
\DeclareRobustCommand{\marcaUnDFTeX}{\NoCaseChange{UnDF-TeX}}
\pdfstringdefDisableCommands{%
  \def\marcaUnDF{UnDF}%
  \def\marcaUnDFTeX{UnDF-TeX}%
}

\titleformat{\chapter}
  {\normalfont\bfseries\large\raggedright}
  {\thechapter}
  {1em}
  {\MakeUppercase}
\titlespacing*{\chapter}{0pt}{0pt}{1.2\baselineskip}

\titleformat{\section}
  {\normalfont\bfseries\normalsize}
  {\thesection}
  {1em}
  {}
\titleformat{\subsection}
  {\normalfont\bfseries\normalsize}
  {\thesubsection}
  {1em}
  {}
\titleformat{\subsubsection}
  {\normalfont\bfseries\itshape\normalsize}
  {\thesubsubsection}
  {1em}
  {}

\renewcommand{\cftchapfont}{\bfseries}
\renewcommand{\cftchappagefont}{\bfseries}
\renewcommand{\cftchapleader}{\cftdotfill{\cftdotsep}}
\setlength{\cftbeforechapskip}{0.45em}
\setlength{\cftsecnumwidth}{3.7em}
\setlength{\cftsubsecnumwidth}{4.8em}
\setlength{\cftsubsubsecnumwidth}{5.8em}

\setlist[itemize]{leftmargin=2em,itemsep=0.15em,topsep=0.35em}
\setlist[enumerate]{leftmargin=2em,itemsep=0.15em,topsep=0.35em}

\newcolumntype{Y}{>{\raggedright\arraybackslash}X}

\captionsetup{
  font=small,
  labelfont=bf,
  justification=raggedright,
  singlelinecheck=false
}

\newcommand{\tiporegra}[1]{%
  \par\smallskip
  \noindent\begin{minipage}{\linewidth}
    \small
    \textbf{ORIGEM DA ORIENTAÇÃO}\par
    #1.
  \end{minipage}\par\smallskip
}

\newcommand{\requisitonormativo}{\tiporegra{Requisito normativo}}
\newcommand{\recomendacaonormativa}{\tiporegra{Recomendação normativa}}
\newcommand{\decisaoinstitucional}{\tiporegra{Decisão institucional validada no âmbito do projeto}}
\newcommand{\regracurso}{\tiporegra{Regra específica de curso ou PPC}}
\newcommand{\boapratica}{\tiporegra{Boa prática acadêmica ou editorial}}
\newcommand{\fluxopendente}{\tiporegra{Fluxo institucional ainda pendente de definição}}

\newcommand{\urlexemplo}[1]{\texttt{\nolinkurl{#1}}}

\newcommand{\refmodelo}[1]{%
  \par\smallskip
  \begingroup
    \singlespacing
    \small
    \setlength{\parindent}{0pt}%
    #1\par
  \endgroup
  \smallskip
}

\newcommand{\caixaorientacao}[1]{%
  \par\smallskip
  \noindent\begingroup
  \setlength{\fboxsep}{8pt}%
  \colorbox{undfGray}{%
    \begin{minipage}{0.95\linewidth}
      \textbf{Orientação.} #1
    \end{minipage}}%
  \endgroup\par\smallskip
}

\newcommand{\caixaatencao}[1]{%
  \par\smallskip
  \noindent\begingroup
  \setlength{\fboxsep}{8pt}%
  \fcolorbox{undfGreen}{white}{%
    \begin{minipage}{0.93\linewidth}
      \textbf{Atenção.} #1
    \end{minipage}}%
  \endgroup\par\smallskip
}

\newcommand{\modeloinstitucional}[2]{%
  \par\medskip
  \noindent\begingroup
  \setlength{\fboxsep}{10pt}%
  \fcolorbox{undfRule}{white}{%
    \begin{minipage}{0.92\linewidth}
      \centering
      {\bfseries #1\par}
      \vspace{0.6em}
      \raggedright
      #2
    \end{minipage}}%
  \endgroup\par\medskip
}

\newcommand{\exemplopagina}[2]{%
  \begin{minipage}[t]{0.47\linewidth}
    \centering
    \fbox{\includegraphics[width=0.90\linewidth]{#1}}\par
    \smallskip
    {\small #2\par}
  \end{minipage}%
}

\newcommand{\manualfrontmatter}{\pagenumbering{roman}}
\newcommand{\manualmainmatter}{\cleardoublepage\pagenumbering{arabic}}
